<!-- AIU-010 Quiet Editorial type ramp and control styles (design specification sections 3, 4 and 9). Colours come from Tokens.xaml only. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas</FontFamily>
  <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
  <!-- D-181 compact Overview: width of the account label column, shared by headers, rows and the skeleton. -->
  <GridLength x:Key="CompactNameWidth">150</GridLength>
  <Thickness x:Key="ContentDialogPadding">0</Thickness>

  <!-- Type ramp -->
  <Style x:Key="BaseText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="0" />
  </Style>
  <Style x:Key="Display64Text" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="FontSize" Value="64" />
    <Setter Property="CharacterSpacing" Value="-20" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="LineHeight" Value="66" />
  </Style>
  <Style x:Key="Display40Text" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="Display22Text" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="Title26Text" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="26" />
  </Style>
  <Style x:Key="Title22Text" TargetType="TextBlock" BasedOn="{StaticResource Title26Text}">
    <Setter Property="FontSize" Value="22" />
  </Style>
  <Style x:Key="Heading20Text" TargetType="TextBlock" BasedOn="{StaticResource Title26Text}">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style x:Key="Heading18Text" TargetType="TextBlock" BasedOn="{StaticResource Title26Text}">
    <Setter Property="FontSize" Value="18" />
  </Style>
  <Style x:Key="Section16Text" TargetType="TextBlock" BasedOn="{StaticResource Title26Text}">
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}" />
  <Style x:Key="BodyStrongText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Body13Text" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Body13StrongText" TargetType="TextBlock" BasedOn="{StaticResource Body13Text}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Body13SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource Body13Text}">
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
  </Style>
  <Style x:Key="Caption11Text" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style x:Key="SectionLabelText" TargetType="TextBlock" BasedOn="{StaticResource Caption11Text}">
    <Setter Property="CharacterSpacing" Value="60" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>
  <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="Foreground" Value="{ThemeResource CritBrush}" />
  </Style>

  <!-- Buttons: secondary (paper), filled (ink primary / crit destructive), link, ghost icon. Disabled keeps size at 50 %. -->
  <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource BtnHoverBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource Card2Brush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.5" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="FilledButtonTemplate" TargetType="Button">
    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.88" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.78" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.5" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="LinkButtonTemplate" TargetType="Button">
    <Grid x:Name="Root" Background="Transparent">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentHoverBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentHoverBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.5" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="GhostButtonTemplate" TargetType="Button">
    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource Stroke2Brush}" />
              <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters>
              <Setter Target="Root.Background" Value="{ThemeResource Stroke2Brush}" />
              <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextBrush}" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters>
              <Setter Target="Root.Opacity" Value="0.5" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
  </ControlTemplate>

  <Style x:Key="AppButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,5,12,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
    <Setter Property="IsTabStop" Value="True" />
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
    <Setter Property="Background" Value="{ThemeResource BtnBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
    <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}" />
  </Style>
  <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="9,2,9,3" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
    <Setter Property="Template" Value="{StaticResource FilledButtonTemplate}" />
  </Style>
  <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,3,10,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
    <Setter Property="Background" Value="{ThemeResource CritBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource DestructiveTextBrush}" />
    <Setter Property="Template" Value="{StaticResource FilledButtonTemplate}" />
  </Style>
  <Style x:Key="SmallDestructiveButton" TargetType="Button" BasedOn="{StaticResource DestructiveButton}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,3,10,4" />
    <Setter Property="MinHeight" Value="26" />
  </Style>
  <Style x:Key="DestructiveOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="BorderBrush" Value="{ThemeResource CritStrokeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource CritBrush}" />
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
    <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template" Value="{StaticResource LinkButtonTemplate}" />
  </Style>
  <Style x:Key="SmallLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="QuietLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="GhostIconButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
    <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
  </Style>

  <!-- Square icon-only header button (Settings) and full-width item of the Add account provider menu. -->
  <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
    <Setter Property="FocusVisualMargin" Value="0" />
    <Setter Property="Template" Value="{StaticResource GhostButtonTemplate}" />
  </Style>

  <!-- Segmented radio (context, presets, density, channel, methods) and underline tab. -->
  <Style x:Key="SegmentRadio" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,5,12,6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-1" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="{TemplateBinding Background}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource TextBrush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{ThemeResource Card2Brush}" Opacity="0" />
            <Border x:Name="Selected" Background="{ThemeResource AccentSoftBrush}" Opacity="0" />
            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegmentHost" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="TabRadio" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
    <Setter Property="Padding" Value="0,8,0,9" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3,0" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Label.Foreground" Value="{ThemeResource TextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Label.Foreground" Value="{ThemeResource TextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Bar.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource TextBrush}" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" AutomationProperties.AccessibilityView="Raw" />
            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Background="{ThemeResource AccentBrush}" Opacity="0" Margin="0,0,0,-1" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs -->
  <Style x:Key="AppTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,5,8,5" />
  </Style>
  <Style x:Key="AppComboBox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style x:Key="AppCheckBox" TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource Text2Brush}" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="HairlineRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style x:Key="CardSurface" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style x:Key="QuietNote" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource Card2Brush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style x:Key="CriticalAlert" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CritBgBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CritStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style x:Key="WarningAlert" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource WarnBgBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource WarnStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style x:Key="OutlineBadge" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource Stroke2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,0,8,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="CodeBlock" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource Card2Brush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
</ResourceDictionary>
