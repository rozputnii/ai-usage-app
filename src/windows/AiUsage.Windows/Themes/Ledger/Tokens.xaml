<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    AIU-038 Ledger tokens (spec section 7, Surfaces Handoff S11). Dark only (D-182): these colours apply whatever the
    Windows app mode or contrast theme; no theme dictionaries and no system brushes. Paint keys used by view models
    ("OkM", "Rail", ...) resolve to Ledger{Key}Color.
  -->
  <Color x:Key="LedgerBgPageColor">#1F1E1D</Color>
  <Color x:Key="LedgerCardColor">#262624</Color>
  <Color x:Key="LedgerCardTopColor">#2A2927</Color>
  <Color x:Key="LedgerCardFreshTopColor">#2F2D2A</Color>
  <Color x:Key="LedgerPanelColor">#232220</Color>
  <Color x:Key="LedgerHistColor">#211F1D</Color>
  <Color x:Key="LedgerInputColor">#1A1918</Color>
  <Color x:Key="LedgerTipColor">#151413</Color>
  <Color x:Key="LedgerLineColor">#2E2D2A</Color>
  <Color x:Key="LedgerLineCardColor">#33322F</Color>
  <Color x:Key="LedgerLineCtlColor">#55534E</Color>
  <Color x:Key="LedgerLineWindowColor">#3A3936</Color>
  <Color x:Key="LedgerLineMutedColor">#4A4844</Color>
  <Color x:Key="LedgerUnderlineColor">#5A5853</Color>
  <Color x:Key="LedgerControlColor">#2A2927</Color>
  <Color x:Key="LedgerControlOnColor">#3A3936</Color>
  <Color x:Key="LedgerInkColor">#F0EEE6</Color>
  <Color x:Key="LedgerInk2Color">#B7B3A8</Color>
  <Color x:Key="LedgerInk3Color">#9D998E</Color>
  <Color x:Key="LedgerRailColor">#34332F</Color>
  <Color x:Key="LedgerPrevColor">#8C887E</Color>
  <Color x:Key="LedgerGreyColor">#75716A</Color>
  <Color x:Key="LedgerOkMColor">#7FB98F</Color>
  <Color x:Key="LedgerOkPColor">#5E8A6B</Color>
  <Color x:Key="LedgerOkTextColor">#7FB98F</Color>
  <Color x:Key="LedgerAttMColor">#D97757</Color>
  <Color x:Key="LedgerAttPColor">#A35C44</Color>
  <Color x:Key="LedgerAttTextColor">#E78E6E</Color>
  <Color x:Key="LedgerCritMColor">#E5604A</Color>
  <Color x:Key="LedgerCritPColor">#B04A3A</Color>
  <Color x:Key="LedgerCritDColor">#6E2E25</Color>
  <Color x:Key="LedgerCritTextColor">#F78570</Color>
  <Color x:Key="LedgerNeutralMColor">#B7B3A8</Color>
  <!-- A sign-in waiting on the user: amber, distinct from success green and the clay of a failure or cancel. -->
  <Color x:Key="LedgerWaitMColor">#E8B04B</Color>
  <Color x:Key="LedgerNeutralPColor">#6C6963</Color>
  <Color x:Key="LedgerPrimaryColor">#E8E4DA</Color>
  <Color x:Key="LedgerOnPrimaryColor">#1A1410</Color>
  <Color x:Key="LedgerFocusColor">#F0EEE6</Color>
  <Color x:Key="LedgerTransparentColor">#00000000</Color>
  <!-- Button feedback washes: hover lightens, press darkens. The light primary surface needs a stronger lift to show. -->
  <Color x:Key="LedgerHoverWashColor">#1AFFFFFF</Color>
  <Color x:Key="LedgerPressWashColor">#42000000</Color>
  <Color x:Key="LedgerPrimaryHoverWashColor">#A6FFFFFF</Color>
  <Color x:Key="LedgerPrimaryPressWashColor">#21000000</Color>
  <!-- Pill backgrounds: the state's mark colour at 14 % (critical 16 %, neutral 12 %), composited over the card. -->
  <Color x:Key="LedgerOkPillColor">#247FB98F</Color>
  <Color x:Key="LedgerAttPillColor">#24D97757</Color>
  <Color x:Key="LedgerCritPillColor">#29E5604A</Color>
  <Color x:Key="LedgerNeutralPillColor">#1FB7B3A8</Color>
  <Color x:Key="LedgerCellLabelColor">#9E1A1410</Color>

  <SolidColorBrush x:Key="LedgerBgPageBrush" Color="{StaticResource LedgerBgPageColor}" />
  <SolidColorBrush x:Key="LedgerCardBrush" Color="{StaticResource LedgerCardColor}" />
  <SolidColorBrush x:Key="LedgerPanelBrush" Color="{StaticResource LedgerPanelColor}" />
  <SolidColorBrush x:Key="LedgerHistBrush" Color="{StaticResource LedgerHistColor}" />
  <SolidColorBrush x:Key="LedgerInputBrush" Color="{StaticResource LedgerInputColor}" />
  <SolidColorBrush x:Key="LedgerTipBrush" Color="{StaticResource LedgerTipColor}" />
  <SolidColorBrush x:Key="LedgerLineBrush" Color="{StaticResource LedgerLineColor}" />
  <SolidColorBrush x:Key="LedgerLineCardBrush" Color="{StaticResource LedgerLineCardColor}" />
  <SolidColorBrush x:Key="LedgerLineCtlBrush" Color="{StaticResource LedgerLineCtlColor}" />
  <SolidColorBrush x:Key="LedgerLineWindowBrush" Color="{StaticResource LedgerLineWindowColor}" />
  <SolidColorBrush x:Key="LedgerLineMutedBrush" Color="{StaticResource LedgerLineMutedColor}" />
  <SolidColorBrush x:Key="LedgerControlBrush" Color="{StaticResource LedgerControlColor}" />
  <SolidColorBrush x:Key="LedgerControlOnBrush" Color="{StaticResource LedgerControlOnColor}" />
  <SolidColorBrush x:Key="LedgerInkBrush" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="LedgerInk2Brush" Color="{StaticResource LedgerInk2Color}" />
  <SolidColorBrush x:Key="LedgerInk3Brush" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="LedgerRailBrush" Color="{StaticResource LedgerRailColor}" />
  <SolidColorBrush x:Key="LedgerPrevBrush" Color="{StaticResource LedgerPrevColor}" />
  <SolidColorBrush x:Key="LedgerOkTextBrush" Color="{StaticResource LedgerOkTextColor}" />
  <SolidColorBrush x:Key="LedgerAttTextBrush" Color="{StaticResource LedgerAttTextColor}" />
  <SolidColorBrush x:Key="LedgerCritTextBrush" Color="{StaticResource LedgerCritTextColor}" />
  <SolidColorBrush x:Key="LedgerCritPBrush" Color="{StaticResource LedgerCritPColor}" />
  <SolidColorBrush x:Key="LedgerOkPBrush" Color="{StaticResource LedgerOkPColor}" />
  <SolidColorBrush x:Key="LedgerNeutralPBrush" Color="{StaticResource LedgerNeutralPColor}" />
  <SolidColorBrush x:Key="LedgerPrimaryBrush" Color="{StaticResource LedgerPrimaryColor}" />
  <SolidColorBrush x:Key="LedgerOnPrimaryBrush" Color="{StaticResource LedgerOnPrimaryColor}" />
  <SolidColorBrush x:Key="LedgerFocusBrush" Color="{StaticResource LedgerFocusColor}" />
  <SolidColorBrush x:Key="LedgerCellLabelBrush" Color="{StaticResource LedgerCellLabelColor}" />
  <SolidColorBrush x:Key="LedgerUnderlineBrush" Color="{StaticResource LedgerUnderlineColor}" />
  <SolidColorBrush x:Key="LedgerHoverWashBrush" Color="{StaticResource LedgerHoverWashColor}" />
  <SolidColorBrush x:Key="LedgerPressWashBrush" Color="{StaticResource LedgerPressWashColor}" />
  <SolidColorBrush x:Key="LedgerPrimaryHoverWashBrush" Color="{StaticResource LedgerPrimaryHoverWashColor}" />
  <SolidColorBrush x:Key="LedgerPrimaryPressWashBrush" Color="{StaticResource LedgerPrimaryPressWashColor}" />
  <LinearGradientBrush x:Key="LedgerCardSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource LedgerCardTopColor}" Offset="0" />
    <GradientStop Color="{StaticResource LedgerCardColor}" Offset="0.6" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LedgerCardFreshSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource LedgerCardFreshTopColor}" Offset="0" />
    <GradientStop Color="{StaticResource LedgerCardColor}" Offset="0.6" />
  </LinearGradientBrush>

  <!--
    Type pairing (Surfaces S11): Source Serif 4 for names and titles, Hanken Grotesk for body and figures, IBM Plex Mono
    for the clock. Static .ttf files approved under PD-038-03; keep each weight's file explicit.
  -->
  <FontFamily x:Key="LedgerSerifFont">ms-appx:///Assets/Fonts/SourceSerif4-Semibold.ttf#Source Serif 4, Segoe UI Variable Text</FontFamily>
  <FontFamily x:Key="LedgerSansFont">ms-appx:///Assets/Fonts/HankenGrotesk-Regular.ttf#Hanken Grotesk, Segoe UI Variable Text</FontFamily>
  <FontFamily x:Key="LedgerSansSemiboldFont">ms-appx:///Assets/Fonts/HankenGrotesk-SemiBold.ttf#Hanken Grotesk, Segoe UI Variable Text</FontFamily>
  <FontFamily x:Key="LedgerMonoFont">ms-appx:///Assets/Fonts/IBMPlexMono-Regular.ttf#IBM Plex Mono, Cascadia Mono, Consolas</FontFamily>

  <!-- Radii (effective px). Squircle surfaces draw their own superellipse; these serve CornerRadius elements (PD-038-02). -->
  <CornerRadius x:Key="LedgerWindowRadius">8</CornerRadius>
  <CornerRadius x:Key="LedgerControlRadius">6</CornerRadius>
  <CornerRadius x:Key="LedgerSegmentRadius">7</CornerRadius>
  <CornerRadius x:Key="LedgerSegmentItemRadius">5</CornerRadius>
  <CornerRadius x:Key="LedgerPillRadius">10</CornerRadius>
  <CornerRadius x:Key="LedgerTipRadius">9</CornerRadius>
</ResourceDictionary>
