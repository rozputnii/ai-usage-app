<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lc="using:AiUsage.Controls.Ledger">
  <!-- AIU-038 Ledger styles (spec section 7). Every colour comes from Tokens.xaml; type ramp and sizes from Surfaces S11. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ms-appx:///Themes/Ledger/Tokens.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Native control templates must also use Ledger paints in a Windows contrast theme. -->
  <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="ScrollBarPanningThumbBackgroundDisabled" Color="{StaticResource LedgerRailColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource LedgerInk2Color}" />
  <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="{StaticResource LedgerRailColor}" />
  <SolidColorBrush x:Key="ScrollBarThumbBorderBrush" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="ScrollBarTrackFill" Color="{StaticResource LedgerBgPageColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource LedgerCardColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackFillDisabled" Color="{StaticResource LedgerBgPageColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="{StaticResource LedgerBgPageColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="{StaticResource LedgerLineColor}" />
  <SolidColorBrush x:Key="ScrollBarTrackStrokeDisabled" Color="{StaticResource LedgerBgPageColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="{StaticResource LedgerInkColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{StaticResource LedgerInk3Color}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="{StaticResource LedgerTipColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource LedgerControlColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource LedgerControlOnColor}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundDisabled" Color="{StaticResource LedgerTipColor}" />

  <Style TargetType="MenuFlyoutPresenter">
    <Setter Property="RequestedTheme" Value="Dark" />
    <Setter Property="HighContrastAdjustment" Value="None" />
    <Setter Property="Background" Value="{StaticResource LedgerTipBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LedgerLineWindowBrush}" />
  </Style>

  <Style TargetType="MenuFlyoutItem">
    <Setter Property="HighContrastAdjustment" Value="None" />
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansFont}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="LedgerCheckBox" TargetType="CheckBox">
    <Setter Property="HighContrastAdjustment" Value="None" />
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInkBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LedgerFocusBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid x:Name="CheckRoot" Background="Transparent" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="{StaticResource LedgerInputBrush}" BorderBrush="{StaticResource LedgerInk3Brush}" BorderThickness="1">
              <Path x:Name="Check" Data="M3,7 L6,10 L12,3" Stroke="{StaticResource LedgerInkBrush}" StrokeThickness="1.5" Opacity="0" />
            </Border>
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Check.Opacity" Value="1" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Box.BorderBrush" Value="{StaticResource LedgerInkBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Box.Background" Value="{StaticResource LedgerControlOnBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CheckRoot.Opacity" Value="0.55" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text: tabular numerals everywhere a figure can appear. -->
  <Style x:Key="LedgerBodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInkBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="LedgerCaptionText" TargetType="TextBlock" BasedOn="{StaticResource LedgerBodyText}">
    <Setter Property="Foreground" Value="{StaticResource LedgerInk3Brush}" />
  </Style>
  <Style x:Key="LedgerStrongText" TargetType="TextBlock" BasedOn="{StaticResource LedgerBodyText}">
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansSemiboldFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="LedgerSectionText" TargetType="TextBlock" BasedOn="{StaticResource LedgerStrongText}">
    <Setter Property="Foreground" Value="{StaticResource LedgerInk2Brush}" />
    <Setter Property="CharacterSpacing" Value="40" />
  </Style>
  <Style x:Key="LedgerIntroText" TargetType="TextBlock" BasedOn="{StaticResource LedgerBodyText}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInk2Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="LedgerCardNameText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LedgerSerifFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInkBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="LedgerTitleText" TargetType="TextBlock" BasedOn="{StaticResource LedgerCardNameText}">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style x:Key="LedgerHeadingText" TargetType="TextBlock" BasedOn="{StaticResource LedgerCardNameText}">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
  </Style>
  <Style x:Key="LedgerClockText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource LedgerMonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInk3Brush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <Style x:Key="LedgerPill" TargetType="Border">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="9,0,9,0" />
    <Setter Property="CornerRadius" Value="{StaticResource LedgerPillRadius}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- One button template: a rounded surface that lightens on hover and darkens on press, and the 2 px ink focus ring. -->
  <Style x:Key="LedgerButtonBase" TargetType="lc:LedgerButton">
    <Setter Property="HoverBrush" Value="{StaticResource LedgerHoverWashBrush}" />
    <Setter Property="PressedBrush" Value="{StaticResource LedgerPressWashBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansSemiboldFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInkBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,2,10,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="{StaticResource LedgerControlRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource LedgerFocusBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="lc:LedgerButton">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <Border x:Name="HoverWash" Background="{TemplateBinding HoverBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="PressWash" Background="{TemplateBinding PressedBrush}" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Presenter" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverWash.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PressWash.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.55" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LedgerPrimaryButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="Background" Value="{StaticResource LedgerPrimaryBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LedgerOnPrimaryBrush}" />
    <Setter Property="HoverBrush" Value="{StaticResource LedgerPrimaryHoverWashBrush}" />
    <Setter Property="PressedBrush" Value="{StaticResource LedgerPrimaryPressWashBrush}" />
  </Style>
  <Style x:Key="LedgerOutlineButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="BorderBrush" Value="{StaticResource LedgerLineCtlBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,1,9,1" />
  </Style>
  <Style x:Key="LedgerDangerButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="Background" Value="{StaticResource LedgerCritPBrush}" />
  </Style>
  <Style x:Key="LedgerLinkButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="Padding" Value="2,0,2,0" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextDecorations="Underline" FontFamily="{StaticResource LedgerSansSemiboldFont}" FontWeight="SemiBold" FontSize="12" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LedgerIconButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Card icons stay visible but quiet; the card raises them to full opacity while the pointer is on the icon. -->
  <Style x:Key="LedgerQuietIconButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerIconButton}">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style x:Key="LedgerTitleIconButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerIconButton}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style x:Key="LedgerFooterButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansFont}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <!-- A segment of a two-way switch (Used/Left, Compact/Comfortable): pressed segments use the control-on surface. -->
  <Style x:Key="LedgerSegmentButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="Padding" Value="10,3,10,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource LedgerSegmentItemRadius}" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInk3Brush}" />
  </Style>

  <Style x:Key="LedgerSegmentOnButton" TargetType="lc:LedgerButton" BasedOn="{StaticResource LedgerButtonBase}">
    <Setter Property="Background" Value="{StaticResource LedgerControlOnBrush}" />
    <Setter Property="Padding" Value="10,3,10,3" />
  </Style>

  <Style x:Key="LedgerNameBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource LedgerSerifFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,1,8,1" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="{StaticResource LedgerControlRadius}" />
    <Setter Property="Background" Value="{StaticResource LedgerInputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LedgerInkBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInkBrush}" />
  </Style>
  <Style x:Key="LedgerAmountBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource LedgerSansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,2,8,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="{StaticResource LedgerControlRadius}" />
    <Setter Property="Background" Value="{StaticResource LedgerInputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LedgerInkBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LedgerInkBrush}" />
  </Style>
</ResourceDictionary>
