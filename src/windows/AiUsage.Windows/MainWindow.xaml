<Window x:Class="AiUsage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dashboard="using:AiUsage.Features.Dashboard" xmlns:tray="using:H.NotifyIcon">
  <StackPanel Padding="32" Spacing="20">
    <tray:TaskbarIcon x:Name="TrayIcon" AutomationProperties.AutomationId="TrayIcon" ToolTipText="AI Usage" LeftClickCommand="{x:Bind ViewModel.ShowCommand}" NoLeftClickDelay="True">
      <tray:TaskbarIcon.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem x:Uid="TrayShow" AutomationProperties.AutomationId="TrayShow" Command="{x:Bind ViewModel.ShowCommand}" />
          <MenuFlyoutItem x:Uid="TrayExit" AutomationProperties.AutomationId="TrayExit" Command="{x:Bind ViewModel.ExitCommand}" />
        </MenuFlyout>
      </tray:TaskbarIcon.ContextFlyout>
    </tray:TaskbarIcon>
    <TextBlock x:Uid="DashboardHeading" AutomationProperties.AutomationId="DashboardHeading" Style="{StaticResource TitleTextBlockStyle}" />
    <TextBlock AutomationProperties.AutomationId="StatusText" TextWrapping="Wrap" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    <TextBlock AutomationProperties.AutomationId="PlanText" Text="{x:Bind ViewModel.PlanText, Mode=OneWay}" />
    <ItemsControl AutomationProperties.AutomationId="QuotaWindows" ItemsSource="{x:Bind ViewModel.Windows, Mode=OneWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="dashboard:QuotaWindowItem">
          <StackPanel Margin="0,0,0,12" Spacing="2">
            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{x:Bind Remaining}" />
            <TextBlock Text="{x:Bind Resets}" Style="{StaticResource CaptionTextBlockStyle}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="FailureMessage" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button x:Name="ConnectButton" x:Uid="ConnectButton" AutomationProperties.AutomationId="ConnectButton" Command="{x:Bind ViewModel.ConnectCommand}" AccessKey="C" />
      <Button x:Name="RefreshButton" x:Uid="RefreshButton" AutomationProperties.AutomationId="RefreshButton" Command="{x:Bind ViewModel.RefreshCommand}" AccessKey="R" />
      <Button x:Name="DisconnectButton" x:Uid="DisconnectButton" AutomationProperties.AutomationId="DisconnectButton" Command="{x:Bind ViewModel.DisconnectCommand}" AccessKey="D" />
      <Button x:Name="ExitButton" x:Uid="ExitButton" AutomationProperties.AutomationId="ExitButton" Command="{x:Bind ViewModel.ExitCommand}" AccessKey="X" />
    </StackPanel>
  </StackPanel>
</Window>
