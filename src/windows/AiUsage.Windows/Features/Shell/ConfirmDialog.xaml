<ContentDialog
    x:Class="AiUsage.Features.Shell.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    AutomationProperties.AutomationId="ConfirmDialog"
    AutomationProperties.Name="{x:Bind ViewModel.Title}"
    Background="{ThemeResource CardBrush}"
    BorderBrush="{ThemeResource Stroke2Brush}"
    BorderThickness="1"
    CornerRadius="8">
  <StackPanel Spacing="12" Padding="20" MaxWidth="440" MinWidth="280">
    <TextBlock Text="{x:Bind ViewModel.Title}" Style="{StaticResource Heading18Text}" AutomationProperties.HeadingLevel="Level2" />
    <TextBlock Text="{x:Bind ViewModel.Body}" Style="{StaticResource Body13SecondaryText}" LineHeight="20" />
    <TextBox x:Name="TypedBox" AutomationProperties.AutomationId="ConfirmTypedText" Style="{StaticResource AppTextBox}"
             Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasTyped)}"
             Header="{x:Bind ViewModel.TypedPrompt}" PlaceholderText="{x:Bind ViewModel.TypedConfirmation}"
             FontFamily="{StaticResource MonoFont}" FontSize="14" IsSpellCheckEnabled="False"
             IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
             Text="{x:Bind ViewModel.TypedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Style="{StaticResource ErrorText}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasError), Mode=OneWay}"
               AutomationProperties.LiveSetting="Assertive" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Padding="0,4,0,0">
      <Button AutomationProperties.AutomationId="ConfirmCancel" Style="{StaticResource SecondaryButton}" Content="{x:Bind ViewModel.CancelLabel}" Command="{x:Bind ViewModel.CancelCommand}" />
      <Button AutomationProperties.AutomationId="ConfirmAlternate" Style="{StaticResource SecondaryButton}" Content="{x:Bind ViewModel.AlternateLabel}"
              Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasAlternate)}" Command="{x:Bind ViewModel.AlternateCommand}" />
      <Button x:Name="ConfirmButton" AutomationProperties.AutomationId="ConfirmAccept" MinWidth="140" Command="{x:Bind ViewModel.ConfirmCommand}"
              AutomationProperties.Name="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:BusyRing Size="12" OnFilled="True" Foreground="{x:Bind ConfirmButton.Foreground, Mode=OneWay}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsBusy), Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.ConfirmLabel, Mode=OneWay}" />
        </StackPanel>
      </Button>
    </StackPanel>
  </StackPanel>
</ContentDialog>
