<UserControl
    x:Class="AiUsage.Features.Shell.ToastPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    IsTabStop="False"
    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsOpen), Mode=OneWay}"
    controls:Motion.Entrance="True">
  <!-- In-window notification preview (S06). Nothing is dispatched to Windows. -->
  <Border Style="{StaticResource CardSurface}" Width="320" Padding="14,12" AutomationProperties.AutomationId="ToastPreview" AutomationProperties.LiveSetting="Polite">
    <StackPanel Spacing="6">
      <TextBlock Text="{x:Bind ViewModel.Prefix, Mode=OneWay}" Style="{StaticResource Caption11Text}" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="14" Height="14" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource Body13StrongText}" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Uid="Toast_Dismiss" AutomationProperties.AutomationId="ToastDismiss" Style="{StaticResource GhostIconButton}" Command="{x:Bind ViewModel.DismissCommand, Mode=OneWay}">
          <TextBlock Text="✕" FontSize="12" />
        </Button>
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.Body, Mode=OneWay}" Style="{StaticResource CaptionText}" />
      <Button x:Uid="Connect_OpenAccount" AutomationProperties.AutomationId="ToastOpenAccount" Style="{StaticResource SmallLinkButton}" Padding="0" HorizontalAlignment="Left" Command="{x:Bind ViewModel.OpenAccountCommand, Mode=OneWay}" />
    </StackPanel>
  </Border>
</UserControl>
