<Page
    x:Class="AiUsage.Features.Accounts.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:accounts="using:AiUsage.Features.Accounts"
    xmlns:platform="using:AiUsage.Platform"
    NavigationCacheMode="Required"
    Background="Transparent"
    AutomationProperties.AccessibilityView="Control"
    AutomationProperties.AutomationId="AccountsPage">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PageRoot" Padding="{x:Bind Gutter(platform:AppLayout.Current.IsCompact), Mode=OneWay}" ColumnSpacing="32" RowSpacing="24" controls:Motion.Entrance="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ListColumn" Width="210" />
        <ColumnDefinition x:Name="DetailColumn" Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Account list in manual order with filters. -->
      <StackPanel x:Name="ListHost" Padding="0,20,0,0">
        <TextBlock x:Uid="Accounts_ListHeading" Style="{StaticResource SectionLabelText}" controls:TextCase.Upper="True" Padding="0,4,0,8" />
        <ListView x:Name="AccountList" AutomationProperties.AutomationId="AccountList" x:Uid="Accounts_ListRegion" ItemsSource="{x:Bind ViewModel.Items}"
                  SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" SelectionMode="Single" Padding="0" Margin="-4,0,0,0">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
              <Setter Property="Padding" Value="10,0" />
              <Setter Property="MinHeight" Value="34" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="CornerRadius" Value="5" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="accounts:AccountListItemViewModel">
              <Grid ColumnSpacing="8" Opacity="{x:Bind controls:Bind.Opacity(IsDisconnected), Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Foreground="{ThemeResource TextBrush}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ValueText, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" controls:Tokens.Foreground="{x:Bind controls:Bind.ToneKey(Tone), Mode=OneWay}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Padding="0,8" Spacing="2" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}">
          <TextBlock x:Uid="Accounts_EmptyList" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Spacing="2" Padding="0,14,0,0">
          <CheckBox AutomationProperties.AutomationId="AccountsShowHidden" Style="{StaticResource AppCheckBox}" Content="{x:Bind ViewModel.ShowHiddenLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.ShowHidden, Mode=TwoWay}" />
          <CheckBox AutomationProperties.AutomationId="AccountsShowDisconnected" Style="{StaticResource AppCheckBox}" Content="{x:Bind ViewModel.ShowDisconnectedLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.ShowDisconnected, Mode=TwoWay}" />
        </StackPanel>
      </StackPanel>

      <!-- No selection -->
      <Border x:Name="NoSelection" Grid.Column="1" Margin="0,20,0,0" MinHeight="200" BorderBrush="{ThemeResource Stroke2Brush}" BorderThickness="1" CornerRadius="8" Padding="40"
              Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowNoSelection), Mode=OneWay}">
        <TextBlock x:Uid="Accounts_NoSelection" Style="{StaticResource Body13SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
      </Border>

      <!-- S02 detail -->
      <StackPanel x:Name="DetailHost" Grid.Column="1" Spacing="16" Padding="0,20,0,8" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasDetail), Mode=OneWay}" AutomationProperties.AutomationId="AccountDetail">
        <Grid ColumnSpacing="14" RowSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="TitleHost" MinWidth="220">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:ProviderTile ProviderId="{x:Bind ViewModel.Detail.ProviderId, Mode=OneWay}" TileSize="16" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind ViewModel.Detail.Meta, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" Visibility="{x:Bind controls:Bind.Collapsed(ViewModel.Detail.Rename.IsEditing), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.Detail.Label, Mode=OneWay}" Style="{StaticResource Title26Text}" AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="DetailTitle" MaxWidth="560" />
              <Button x:Uid="Detail_Rename" AutomationProperties.AutomationId="DetailRename" Style="{StaticResource SmallLinkButton}" VerticalAlignment="Center" Command="{x:Bind ViewModel.Detail.StartRenameCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.Rename.IsEditing), Mode=OneWay}">
              <StackPanel Spacing="4">
                <TextBox x:Name="RenameBox" x:Uid="Detail_RenameBox" AutomationProperties.AutomationId="RenameBox" FontSize="16" MinWidth="220" CornerRadius="5" Padding="10,5"
                         Text="{x:Bind ViewModel.Detail.Rename.LabelText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnRenameKeyDown"
                         controls:Tokens.Border="{x:Bind RenameBorder(ViewModel.Detail.Rename.HasError), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Detail.Rename.ErrorText, Mode=OneWay}" Style="{StaticResource ErrorText}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.Rename.HasError), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
              </StackPanel>
              <Button x:Uid="Action_SaveButton" AutomationProperties.AutomationId="RenameSave" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Command="{x:Bind ViewModel.Detail.Rename.SaveCommand}" />
              <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="RenameCancel" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Command="{x:Bind ViewModel.Detail.Rename.CancelCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
              <controls:StatusPill Text="{x:Bind ViewModel.Detail.Pill.Text, Mode=OneWay}" Tone="{x:Bind ViewModel.Detail.Pill.Tone, Mode=OneWay}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.IsRefreshing), Mode=OneWay}">
                <controls:BusyRing Size="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.IsRefreshing), Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock x:Uid="Row_Updating" Style="{StaticResource CaptionText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button x:Uid="Row_Cancel" AutomationProperties.AutomationId="DetailCancelRefresh" Style="{StaticResource SmallLinkButton}" Command="{x:Bind ViewModel.Detail.CancelRefreshCommand}" />
              </StackPanel>
              <TextBlock x:Uid="Row_Updated" FontSize="12" Foreground="{ThemeResource OkBrush}" VerticalAlignment="Center" Visibility="Collapsed" controls:Motion.Acknowledge="{x:Bind ViewModel.Detail.ShowAck, Mode=OneWay}" />
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="ActionsHost" Grid.Column="1" Orientation="Horizontal" Spacing="8" Padding="0,18,0,0" VerticalAlignment="Top">
            <Button x:Uid="ProviderHistory_Open" AutomationProperties.AutomationId="DetailHistory" Command="{x:Bind ViewModel.Detail.OpenHistoryCommand}" Style="{StaticResource SecondaryButton}" />
            <Button AutomationProperties.AutomationId="DetailRefresh" Style="{StaticResource SecondaryButton}" MinWidth="96" Command="{x:Bind ViewModel.Detail.RefreshCommand}" x:Uid="Detail_RefreshButton">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <controls:RefreshGlyph IsSpinning="{x:Bind ViewModel.Detail.IsRefreshing, Mode=OneWay}" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Uid="Detail_RefreshLabel" />
              </StackPanel>
            </Button>
            <Button x:Name="ReconnectButton" AutomationProperties.AutomationId="DetailReconnect" Content="{x:Bind ViewModel.Detail.ReconnectLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Detail.ReconnectCommand}"
                    Style="{x:Bind ReconnectStyle(ViewModel.Detail.ReconnectIsPrimary), Mode=OneWay}" />
            <Button x:Uid="Detail_MoreActions" AutomationProperties.AutomationId="DetailMore" Style="{StaticResource SecondaryButton}" Padding="10,5,10,6">
              <TextBlock Text="···" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuFlyoutItem x:Uid="Menu_MoveUp" AutomationProperties.AutomationId="MenuMoveUp" Command="{x:Bind ViewModel.Detail.MoveUpCommand}" />
                  <MenuFlyoutItem x:Uid="Menu_MoveDown" AutomationProperties.AutomationId="MenuMoveDown" Command="{x:Bind ViewModel.Detail.MoveDownCommand}" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="MenuHide" Text="{x:Bind ViewModel.Detail.HideMenuLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Detail.ToggleAccountHiddenCommand}" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="MenuMute" Text="{x:Bind ViewModel.Detail.MuteMenuLabel, Mode=OneWay}" controls:CapabilityGate.Key="SetMute" Command="{x:Bind ViewModel.Detail.ToggleMuteCommand}" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem controls:CapabilityGate.Key="DeleteAccountData" x:Uid="Menu_DeleteData" AutomationProperties.AutomationId="MenuDeleteData" Command="{x:Bind ViewModel.Detail.DeleteStoredDataCommand}" Foreground="{ThemeResource CritBrush}" />
                  <MenuFlyoutItem AutomationProperties.AutomationId="MenuDisconnect" Text="{x:Bind ViewModel.Detail.DisconnectMenuLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Detail.DisconnectCommand}" Foreground="{ThemeResource CritBrush}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>

        <!-- Hero: primary window value, meter, reset, and 24 h sparkline (D10). -->
        <Border Style="{StaticResource HairlineRow}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.HasHero), Mode=OneWay}">
          <Grid x:Name="HeroGrid" ColumnSpacing="28" RowSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="HeroValueColumn" Width="Auto" MinWidth="220" />
              <ColumnDefinition x:Name="HeroMeterColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel AutomationProperties.Name="{x:Bind ViewModel.Detail.Hero.AccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="DetailHero">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Detail.Hero.Glyph, Mode=OneWay}" FontSize="20" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.VisibleText(ViewModel.Detail.Hero.Glyph), Mode=OneWay}"
                           controls:Tokens.Foreground="{x:Bind controls:Bind.ToneKey(ViewModel.Detail.Hero.Tone), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Detail.Hero.ValueText, Mode=OneWay}" Style="{StaticResource Display64Text}" controls:Tokens.Foreground="{x:Bind controls:Bind.ToneKey(ViewModel.Detail.Hero.Tone), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.Detail.Hero.UnitText, Mode=OneWay}" Style="{StaticResource CaptionText}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,10" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.Detail.HeroLabel, Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="HeroMeterHost" Grid.Column="1" VerticalAlignment="Bottom" Padding="0,0,0,6" Spacing="8">
              <controls:Sparkline Model="{x:Bind ViewModel.Detail.Sparkline, Mode=OneWay}" Height="32" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.HasSparkline), Mode=OneWay}" />
              <controls:QuotaMeter Kind="{x:Bind ViewModel.Detail.Hero.Kind, Mode=OneWay}" Tone="{x:Bind ViewModel.Detail.Hero.Tone, Mode=OneWay}" Ticks="{x:Bind ViewModel.Detail.Hero.Ticks, Mode=OneWay}"
                                   Observation="{x:Bind ViewModel.Detail.Hero.Observation, Mode=OneWay}" Fraction="{x:Bind ViewModel.Detail.Hero.Fraction, Mode=OneWay}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.Detail.Hero.ResetRelative, Mode=OneWay}" FontSize="12" controls:Tokens.Foreground="{x:Bind ResetKey(ViewModel.Detail.Hero.ResetIsCritical), Mode=OneWay}" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Detail.Hero.ResetExact, Mode=OneWay}" FontSize="12" controls:Tokens.Foreground="{x:Bind ResetKey(ViewModel.Detail.Hero.ResetIsCritical), Mode=OneWay}" />
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Contexts (F07) -->
        <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="6" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.HasContexts), Mode=OneWay}">
          <TextBlock x:Uid="Detail_ContextLabel" Style="{StaticResource Body13SecondaryText}" VerticalAlignment="Center" />
          <Border Style="{StaticResource SegmentHost}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Contexts}" AutomationProperties.AutomationId="DetailContexts" x:Uid="Detail_ContextGroup" XYFocusKeyboardNavigation="Enabled">
              <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="accounts:ContextOptionViewModel">
                  <RadioButton Style="{StaticResource SegmentRadio}" Content="{x:Bind Label, Mode=OneWay}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Padding="14,5,14,6" Click="OnContextClick" Tag="{x:Bind}" />
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </Border>
          <TextBlock Text="{x:Bind ViewModel.Detail.ContextKindText, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        </controls:WrapPanel>

        <Border Style="{StaticResource QuietNote}" Padding="14,10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.HasDisconnectedNote), Mode=OneWay}">
          <TextBlock Text="{x:Bind ViewModel.Detail.DisconnectedNote, Mode=OneWay}" Style="{StaticResource Body13Text}" LineHeight="19" />
        </Border>
        <Border Style="{StaticResource CriticalAlert}" Visibility="{x:Bind ViewModel.Detail.Failure.IsVisible, Mode=OneWay}" AutomationProperties.AutomationId="DetailFailure" controls:Motion.Entrance="True">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Detail.Failure.Message, Mode=OneWay}" Style="{StaticResource Body13Text}" LineHeight="19" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button AutomationProperties.AutomationId="DetailRetry" Style="{StaticResource SmallSecondaryButton}" Content="{x:Bind ViewModel.Detail.Failure.ActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.Detail.RetryCommand}"
                      IsEnabled="{x:Bind ViewModel.Detail.Failure.ActionEnabled, Mode=OneWay}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.Failure.HasAction), Mode=OneWay}" />
              <TextBlock Text="{x:Bind ViewModel.Detail.Failure.WaitText, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.Failure.HasWait), Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Groups -->
        <StackPanel Opacity="{x:Bind controls:Bind.Opacity(ViewModel.Detail.IsDisconnected), Mode=OneWay}">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Groups}" AutomationProperties.AutomationId="DetailGroups">
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="accounts:QuotaGroupViewModel">
                <StackPanel>
                  <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4" Margin="0,14,0,6">
                    <Button Style="{StaticResource QuietLinkButton}" Padding="0" Command="{x:Bind ToggleExpansionCommand}" AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind ExpansionText, Mode=OneWay}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="›" FontSize="12" Width="10" TextAlignment="Center" controls:Motion.Rotate="{x:Bind controls:Bind.Rotation(IsExpanded), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource SectionLabelText}" controls:TextCase.Upper="True" />
                      </StackPanel>
                    </Button>
                    <Border Style="{StaticResource OutlineBadge}" Visibility="{x:Bind controls:Bind.Visible(IsSharedPool), Mode=OneWay}">
                      <TextBlock Text="{x:Bind SharedPoolBadge, Mode=OneWay}" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource OutlineBadge}" BorderBrush="{ThemeResource StrokeBrush}" Visibility="{x:Bind controls:Bind.Visible(IsHidden), Mode=OneWay}">
                      <TextBlock x:Uid="Group_HiddenBadge" FontSize="11" Foreground="{ThemeResource Text2Brush}" />
                    </Border>
                    <TextBlock Text="{x:Bind ExpansionText, Mode=OneWay}" Style="{StaticResource Caption11Text}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource SmallSecondaryButton}" Background="Transparent" FontSize="11" Padding="8,0,8,1" MinHeight="20" Foreground="{ThemeResource Text2Brush}"
                            Content="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHideCommand}" />
                  </controls:WrapPanel>
                  <Border Style="{StaticResource HairlineRow}" Padding="0,6,0,4" Visibility="{x:Bind controls:Bind.Visible(ShowCollapsedSummary), Mode=OneWay}">
                    <TextBlock Text="{x:Bind CollapsedSummary, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                  </Border>
                  <ItemsRepeater ItemsSource="{x:Bind Windows}" Visibility="{x:Bind controls:Bind.Visible(IsExpanded), Mode=OneWay}" controls:Motion.Entrance="True">
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="accounts:QuotaWindowViewModel">
                        <Border Style="{StaticResource HairlineRow}" Padding="{x:Bind controls:Bind.RowPadding(platform:AppLayout.Current.CompactDensity), Mode=OneWay}">
                          <accounts:WindowLineView Window="{x:Bind}" />
                        </Border>
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </StackPanel>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>

          <Border Style="{StaticResource HairlineRow}" Margin="0,12,0,0" Padding="0,16,0,0" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.HasExtensions), Mode=OneWay}">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.Extensions}" AutomationProperties.AutomationId="DetailExtensions">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="200" MinColumnSpacing="24" MinRowSpacing="16" ItemsStretch="Fill" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="accounts:ExtensionViewModel">
                  <StackPanel>
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SectionLabelText}" TextWrapping="Wrap" controls:TextCase.Upper="True" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                      <Run Text="{x:Bind Value, Mode=OneWay}" FontSize="15" /><Run Text=" " /><Run Text="{x:Bind Note, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource Text2Brush}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </Border>
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Detail.InfoLines}" Margin="0,10,0,0" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Detail.HasInfo), Mode=OneWay}">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Vertical" Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}" Style="{StaticResource CaptionText}" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Detail.ObservedText, Mode=OneWay}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="DetailObserved" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
