<Page
    x:Class="AiUsage.Features.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:history="using:AiUsage.Features.History"
    xmlns:platform="using:AiUsage.Platform"
    NavigationCacheMode="Required"
    Background="Transparent"
    AutomationProperties.AccessibilityView="Control"
    AutomationProperties.AutomationId="HistoryPage">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="{x:Bind Gutter(platform:AppLayout.Current.IsCompact), Mode=OneWay}" Spacing="14" controls:Motion.Entrance="True">
      <StackPanel Padding="0,20,0,0">
        <TextBlock x:Uid="History_Title" Style="{StaticResource Title26Text}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
      </StackPanel>

      <Border Style="{StaticResource WarningAlert}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.CollectionDisabled), Mode=OneWay}" AutomationProperties.AutomationId="HistoryDisabledBanner">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Uid="History_DisabledBanner" Style="{StaticResource Body13Text}" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Uid="History_OpenData" AutomationProperties.AutomationId="HistoryOpenData" Style="{StaticResource SmallSecondaryButton}" Command="{x:Bind ViewModel.OpenDataPrivacyCommand}" />
        </Grid>
      </Border>

      <!-- Filters: account, window (context and group folded into the label), presets, custom range. -->
      <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
        <ComboBox x:Uid="History_AccountFilter" AutomationProperties.AutomationId="HistoryAccount" Style="{StaticResource AppComboBox}" MinWidth="150" MaxWidth="220"
                  ItemsSource="{x:Bind ViewModel.AccountOptions}" SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay, Converter={StaticResource PassThrough}}" DisplayMemberPath="Label" VerticalAlignment="Bottom" />
        <ComboBox x:Uid="History_WindowFilter" AutomationProperties.AutomationId="HistoryWindow" Style="{StaticResource AppComboBox}" MinWidth="180" MaxWidth="320"
                  ItemsSource="{x:Bind ViewModel.WindowOptions}" SelectedItem="{x:Bind ViewModel.SelectedWindow, Mode=TwoWay, Converter={StaticResource PassThrough}}" DisplayMemberPath="Label" VerticalAlignment="Bottom" />
        <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Bottom">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Presets}" AutomationProperties.AutomationId="HistoryRange" x:Uid="History_RangeGroup" XYFocusKeyboardNavigation="Enabled">
            <ItemsRepeater.Layout>
              <StackLayout Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="history:RangePresetViewModel">
                <RadioButton Style="{StaticResource SegmentRadio}" Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Padding="11,6,11,7" Click="OnPresetClick" Tag="{x:Bind}" />
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsCustom), Mode=OneWay}">
          <TextBox x:Uid="History_From" AutomationProperties.AutomationId="HistoryFrom" Style="{StaticResource AppTextBox}" Width="150" Text="{x:Bind ViewModel.CustomFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox x:Uid="History_To" AutomationProperties.AutomationId="HistoryTo" Style="{StaticResource AppTextBox}" Width="150" Text="{x:Bind ViewModel.CustomTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <Button x:Uid="History_Apply" AutomationProperties.AutomationId="HistoryApply" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ApplyCustomCommand}" />
        </StackPanel>
      </controls:WrapPanel>
      <TextBlock Text="{x:Bind ViewModel.RangeError, Mode=OneWay}" Style="{StaticResource ErrorText}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasRangeError), Mode=OneWay}"
                 AutomationProperties.AutomationId="HistoryRangeError" AutomationProperties.LiveSetting="Assertive" />

      <Border Style="{StaticResource HairlineRow}" Padding="0,14" MinHeight="280">
        <Grid>
          <StackPanel Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsLoading), Mode=OneWay}" AutomationProperties.AutomationId="HistorySkeleton">
            <controls:SkeletonBlock Height="12" Width="220" HorizontalAlignment="Left" Shimmer="True" />
            <controls:SkeletonBlock Height="220" CornerRadius="6" Shimmer="True" />
            <TextBlock x:Uid="History_Loading" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <Grid MinHeight="220" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}" AutomationProperties.AutomationId="HistoryEmpty">
            <StackPanel MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Uid="History_EmptyTitle" Style="{StaticResource Body13StrongText}" HorizontalAlignment="Center" TextAlignment="Center" />
              <TextBlock Text="{x:Bind ViewModel.EmptyReason, Mode=OneWay}" Style="{StaticResource Body13SecondaryText}" TextAlignment="Center" Margin="0,4,0,0" LineHeight="19" />
            </StackPanel>
          </Grid>
          <StackPanel Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasChart), Mode=OneWay}" controls:Motion.Entrance="True">
            <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" Style="{StaticResource CaptionText}" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
            </Grid>
            <controls:HistoryChart x:Uid="History_Chart" AutomationProperties.AutomationId="HistoryChart" AutomationProperties.Name="{x:Bind ViewModel.ChartAccessibleName, Mode=OneWay}"
                                   Model="{x:Bind ViewModel.Chart, Mode=OneWay}" AxisTop="{x:Bind ViewModel.AxisTop, Mode=OneWay}" AxisMiddle="{x:Bind ViewModel.AxisMiddle, Mode=OneWay}"
                                   AxisBottom="{x:Bind ViewModel.AxisBottom, Mode=OneWay}" PointFocusedCommand="{x:Bind ViewModel.ShowTooltipCommand}" PointLeftCommand="{x:Bind ViewModel.HideTooltipCommand}" />
            <TextBlock Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}" Opacity="0" Height="0" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HistoryTooltipText" />
            <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Rectangle Width="14" Height="2" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.LegendObserved, Mode=OneWay}" Style="{StaticResource Caption11Text}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Rectangle Width="14" Height="10" Fill="{ThemeResource HatchBrush}" Opacity="0.4" VerticalAlignment="Center" />
                <TextBlock x:Uid="History_LegendGap" Style="{StaticResource Caption11Text}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Line X1="0" X2="14" Y1="0" Y2="0" Stroke="{ThemeResource Text2Brush}" StrokeDashArray="2,2" VerticalAlignment="Center" />
                <TextBlock x:Uid="History_LegendReset" Style="{StaticResource Caption11Text}" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.PointCountText, Mode=OneWay}" Style="{StaticResource Caption11Text}" />
              <TextBlock x:Uid="History_PartialNote" Style="{StaticResource Caption11Text}" Foreground="{ThemeResource WarnBrush}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsPartial), Mode=OneWay}" />
            </controls:WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
