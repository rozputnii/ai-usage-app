<Page
    x:Class="AiUsage.Features.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:history="using:AiUsage.Features.History"
    xmlns:platform="using:AiUsage.Platform"
    NavigationCacheMode="Required" Background="Transparent" AutomationProperties.AutomationId="HistoryPage">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
    <StackPanel Padding="{x:Bind Gutter(platform:AppLayout.Current.IsCompact), Mode=OneWay}" Spacing="16">
      <StackPanel Margin="0,20,0,0" Spacing="4">
        <TextBlock x:Uid="History_Title" Style="{StaticResource Title26Text}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{x:Bind ViewModel.Subtitle}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
      </StackPanel>
      <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
        <ComboBox x:Uid="History_AccountFilter" AutomationProperties.AutomationId="HistoryAccount" MinWidth="180" MaxWidth="300"
          ItemsSource="{x:Bind ViewModel.Accounts}" SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay, Converter={StaticResource PassThrough}}" DisplayMemberPath="Label" />
        <ComboBox x:Uid="ProviderHistory_Period" AutomationProperties.AutomationId="ProviderHistoryPeriod" MinWidth="140"
          ItemsSource="{x:Bind ViewModel.Ranges}" SelectedItem="{x:Bind ViewModel.SelectedRange, Mode=TwoWay, Converter={StaticResource PassThrough}}" DisplayMemberPath="Label" />
        <Button x:Uid="ProviderHistory_Refresh" AutomationProperties.AutomationId="ProviderHistoryRefresh" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Bottom" />
      </controls:WrapPanel>
      <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsCustom), Mode=OneWay}">
        <TextBox x:Uid="ProviderHistory_From" Text="{x:Bind ViewModel.CustomFrom, Mode=TwoWay}" Width="160" />
        <TextBox x:Uid="ProviderHistory_To" Text="{x:Bind ViewModel.CustomTo, Mode=TwoWay}" Width="160" />
        <Button x:Uid="ProviderHistory_Apply" Command="{x:Bind ViewModel.ApplyCommand}" VerticalAlignment="Bottom" />
      </controls:WrapPanel>
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource WarnBrush}" />
      <TextBlock x:Uid="ProviderHistory_NoAccounts" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasNoAccounts), Mode=OneWay}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Sections}" AutomationProperties.AutomationId="ProviderHistorySections">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="history:ProviderHistorySection">
            <Border Style="{StaticResource CardSurface}" Margin="0,0,0,16" Padding="20">
              <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind Label}" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind controls:Bind.Visible(IsLoading), Mode=OneWay}" AutomationProperties.Name="Loading provider history" />
                <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Retrieved, Mode=OneWay}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{x:Bind Reports, Mode=OneWay}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="history:ProviderHistoryReport">
                      <StackPanel Spacing="6" Margin="0,8,0,8">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        <ListView ItemsSource="{x:Bind Rows}" SelectionMode="None" MaxHeight="320" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProviderHistoryRows">
                          <ListView.ItemTemplate>
                            <DataTemplate x:DataType="history:ProviderHistoryRow">
                              <StackPanel Spacing="3" Padding="0,5">
                                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="3">
                                  <TextBlock Text="{x:Bind Period}" MinWidth="100" />
                                  <TextBlock Text="{x:Bind Metric}" MinWidth="110" />
                                  <TextBlock Text="{x:Bind Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </controls:WrapPanel>
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
