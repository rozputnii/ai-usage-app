<UserControl
    x:Class="AiUsage.Features.CliImport.CliImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:cli="using:AiUsage.Features.CliImport"
    AutomationProperties.AutomationId="CliImport">
  <StackPanel Spacing="12">
    <TextBlock x:Uid="Cli_Intro" Style="{StaticResource CaptionText}" LineHeight="18" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Uid="Cli_Scan" AutomationProperties.AutomationId="CliScan" Style="{StaticResource PrimaryButton}" MinWidth="140" Padding="14,6,14,7"
              controls:CapabilityGate.Key="DiscoverCli" Command="{x:Bind ViewModel.ScanCommand, Mode=OneWay}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsIdle), Mode=OneWay}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsScanning), Mode=OneWay}">
        <controls:BusyRing Size="14" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsScanning), Mode=OneWay}" VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.ScanningText, Mode=OneWay}" Style="{StaticResource Body13Text}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        <Button x:Uid="Cli_Stop" AutomationProperties.AutomationId="CliStop" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}" />
      </StackPanel>
      <Button x:Uid="Cli_Rescan" AutomationProperties.AutomationId="CliRescan" Style="{StaticResource SecondaryButton}" Padding="14,6,14,7"
              controls:CapabilityGate.Key="DiscoverCli" Command="{x:Bind ViewModel.ScanCommand, Mode=OneWay}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.CanRescan), Mode=OneWay}" />
    </StackPanel>
    <TextBlock x:Uid="Cli_NoCandidates" Style="{StaticResource Body13SecondaryText}" Padding="0,10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.NoCandidates), Mode=OneWay}" />
    <StackPanel Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowList), Mode=OneWay}">
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" AutomationProperties.AutomationId="CliCandidates">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="cli:CliCandidateViewModel">
            <Border Style="{StaticResource HairlineRow}" Padding="0,9" controls:Motion.Entrance="True">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource AppCheckBox}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" AutomationProperties.Name="{x:Bind Label}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                <controls:ProviderTile Grid.Column="1" ProviderId="{x:Bind Candidate.ProviderId}" TileSize="22" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource Body13Text}" />
                  <TextBlock Text="{x:Bind Candidate.DisplayPath}" Style="{StaticResource Caption11Text}" FontFamily="{StaticResource MonoFont}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(HasOutcome), Mode=OneWay}">
                  <controls:BusyRing Size="10" Visibility="{x:Bind controls:Bind.Visible(IsImporting), Mode=OneWay}" VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind OutcomeText, Mode=OneWay}" FontSize="12" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="190" controls:Tokens.Foreground="{x:Bind controls:Bind.OutcomeKey(Tone), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
      <Border Style="{StaticResource HairlineRow}" Padding="0,12,0,0">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Uid="Cli_ImportingNote" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsImporting), Mode=OneWay}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="CliCancelImport" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.CancelImportCommand, Mode=OneWay}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsImporting), Mode=OneWay}" />
            <Button x:Uid="Cli_Reimport" controls:CapabilityGate.Key="ReimportCli" AutomationProperties.AutomationId="CliReimport" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.ReimportSelectedCommand, Mode=OneWay}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsDone), Mode=OneWay}" />
            <Button x:Uid="Cli_Done" AutomationProperties.AutomationId="CliDone" Style="{StaticResource PrimaryButton}" Command="{x:Bind CloseCommand, Mode=OneWay}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsDone), Mode=OneWay}" />
            <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="CliCancel" Style="{StaticResource SecondaryButton}" Command="{x:Bind CloseCommand, Mode=OneWay}"
                    Visibility="{x:Bind FoundVisible(ViewModel.CanRescan, ViewModel.IsDone), Mode=OneWay}" />
            <Button controls:CapabilityGate.Key="ImportCli" AutomationProperties.AutomationId="CliImportSelected" Style="{StaticResource PrimaryButton}" Content="{x:Bind ViewModel.ImportLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ImportSelectedCommand, Mode=OneWay}"
                    Visibility="{x:Bind FoundVisible(ViewModel.CanRescan, ViewModel.IsDone), Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
