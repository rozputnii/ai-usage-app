<Page
    x:Class="AiUsage.Features.Overview.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:overview="using:AiUsage.Features.Overview"
    xmlns:connection="using:AiUsage.Features.Connection"
    xmlns:platform="using:AiUsage.Platform"
    NavigationCacheMode="Required"
    Background="Transparent"
    AutomationProperties.AccessibilityView="Control"
    AutomationProperties.AutomationId="OverviewPage">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="PageRoot" Padding="{x:Bind Gutter(platform:AppLayout.Current.IsCompact), Mode=OneWay}" controls:Motion.Entrance="True">
      <!-- Skeleton: mirrors the compact layout (provider header, rows with label and bars). -->
      <StackPanel AutomationProperties.AutomationId="OverviewSkeleton" x:Uid="Overview_LoadingRegion" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsLoading), Mode=OneWay}">
        <overview:SkeletonRows />
        <overview:SkeletonRows />
        <Border Style="{StaticResource HairlineRow}" />
        <TextBlock x:Uid="Overview_LoadingText" Style="{StaticResource CaptionText}" Padding="0,10,0,0" />
      </StackPanel>

      <!-- First run -->
      <Grid Padding="20,64" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsFirstRun), Mode=OneWay}" AutomationProperties.AutomationId="OverviewEmpty" controls:Motion.Entrance="True">
        <StackPanel MaxWidth="420" HorizontalAlignment="Center">
          <Border Width="44" Height="44" CornerRadius="22" BorderBrush="{ThemeResource Stroke2Brush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
            <TextBlock Text="+" FontSize="20" Foreground="{ThemeResource Text2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
          </Border>
          <TextBlock x:Uid="Overview_EmptyTitle" Style="{StaticResource Heading20Text}" HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock x:Uid="Overview_EmptyBody" Style="{StaticResource Body13SecondaryText}" TextAlignment="Center" Margin="0,8,0,18" LineHeight="20" />
          <!-- One click on a provider starts browser sign-in, exactly like the header Add account menu. -->
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.AddAccount.ProviderOptions}" AutomationProperties.AutomationId="EmptyAddAccount" x:Uid="AddAccount_Menu">
            <ItemsRepeater.Layout>
              <UniformGridLayout MinItemWidth="190" MinItemHeight="58" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" MaximumRowsOrColumns="2" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="connection:ProviderOptionViewModel">
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,9" CornerRadius="7"
                        Click="OnProviderClick" Tag="{x:Bind}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                        AutomationProperties.AutomationId="{x:Bind AutomationId}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Availability, Mode=OneWay}">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ProviderTile ProviderId="{x:Bind ProviderId}" TileSize="24" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource Body13StrongText}" />
                      <TextBlock Text="{x:Bind Availability, Mode=OneWay}" Style="{StaticResource Caption11Text}" Visibility="{x:Bind controls:Bind.Visible(HasAvailability), Mode=OneWay}" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </StackPanel>
      </Grid>

      <!-- All hidden -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Padding="32" Spacing="4" Visibility="{x:Bind controls:Bind.Visible(ViewModel.AllHidden), Mode=OneWay}" AutomationProperties.AutomationId="OverviewAllHidden">
        <TextBlock x:Uid="Overview_AllHidden" Style="{StaticResource Body13SecondaryText}" VerticalAlignment="Center" />
        <Button x:Uid="Overview_ShowAll" AutomationProperties.AutomationId="OverviewShowAll" Style="{StaticResource LinkButton}" Command="{x:Bind ViewModel.ShowHiddenAndDisconnectedCommand}" />
      </StackPanel>

      <!-- Rows (D-181): one line per account; window names appear once per provider above the bar columns. -->
      <StackPanel Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasRows), Mode=OneWay}">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections}" AutomationProperties.AutomationId="ProviderSections">
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="overview:ProviderSectionViewModel">
              <StackPanel>
                <Grid ColumnSpacing="16" Padding="0,16,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource CompactNameWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ProviderTile ProviderId="{x:Bind ProviderId}" TileSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource SectionLabelText}" controls:TextCase.Upper="True" VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level2" />
                  </StackPanel>
                  <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Columns}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <ItemsRepeater.Layout>
                      <UniformGridLayout MinItemWidth="40" MinColumnSpacing="16" ItemsStretch="Fill" MaximumRowsOrColumns="{x:Bind controls:Bind.AtLeastOne(Columns.Count), Mode=OneWay}" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource Caption11Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                  </ItemsRepeater>
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind Rows}" AutomationProperties.Name="{x:Bind ListName, Mode=OneWay}">
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="overview:AccountRowViewModel">
                      <overview:AccountRowView Row="{x:Bind}" />
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <Border Style="{StaticResource HairlineRow}" Margin="0,0,0,24" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
