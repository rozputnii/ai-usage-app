<UserControl
    x:Class="AiUsage.Features.Overview.SkeletonRows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">
  <!-- One provider header and two account rows with window lines; matches the loaded row geometry so nothing shifts. -->
  <StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,14,0,3">
      <controls:SkeletonBlock Width="18" Height="18" CornerRadius="4" />
      <controls:SkeletonBlock Width="60" Height="9" VerticalAlignment="Center" />
    </StackPanel>
    <Border x:Name="RowA" Style="{StaticResource HairlineRow}" Padding="0,11">
      <Grid x:Name="GridA" ColumnSpacing="24" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="7">
          <controls:SkeletonBlock Height="12" Width="100" HorizontalAlignment="Left" Shimmer="True" />
          <controls:SkeletonBlock Height="16" Width="140" HorizontalAlignment="Left" CornerRadius="8" />
          <controls:SkeletonBlock Height="10" Width="72" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel x:Name="LinesA" Grid.Column="1" Spacing="10" Padding="0,6,0,0">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <controls:SkeletonBlock Height="10" Width="88" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <controls:SkeletonBlock Grid.Column="1" Height="4" CornerRadius="2" Shimmer="True" VerticalAlignment="Center" />
            <controls:SkeletonBlock Grid.Column="2" Height="20" Width="52" CornerRadius="4" HorizontalAlignment="Right" Shimmer="True" />
            <controls:SkeletonBlock Grid.Column="3" Height="9" Width="140" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <controls:SkeletonBlock Height="10" Width="88" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <controls:SkeletonBlock Grid.Column="1" Height="4" CornerRadius="2" Shimmer="True" VerticalAlignment="Center" />
            <controls:SkeletonBlock Grid.Column="2" Height="20" Width="52" CornerRadius="4" HorizontalAlignment="Right" Shimmer="True" />
            <controls:SkeletonBlock Grid.Column="3" Height="9" Width="140" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{StaticResource HairlineRow}" Padding="0,11">
      <Grid x:Name="GridB" ColumnSpacing="24" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="7">
          <controls:SkeletonBlock Height="12" Width="100" HorizontalAlignment="Left" Shimmer="True" />
          <controls:SkeletonBlock Height="16" Width="140" HorizontalAlignment="Left" CornerRadius="8" />
          <controls:SkeletonBlock Height="10" Width="72" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel x:Name="LinesB" Grid.Column="1" Spacing="10" Padding="0,6,0,0">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>
            <controls:SkeletonBlock Height="10" Width="88" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <controls:SkeletonBlock Grid.Column="1" Height="4" CornerRadius="2" Shimmer="True" VerticalAlignment="Center" />
            <controls:SkeletonBlock Grid.Column="2" Height="20" Width="52" CornerRadius="4" HorizontalAlignment="Right" Shimmer="True" />
            <controls:SkeletonBlock Grid.Column="3" Height="9" Width="140" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
