<UserControl
    x:Class="AiUsage.Features.Overview.SkeletonRows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">
  <!-- One provider header and two compact rows (label, two bars); matches the loaded geometry so nothing shifts. -->
  <StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,16,0,6">
      <controls:SkeletonBlock Width="16" Height="16" CornerRadius="4" />
      <controls:SkeletonBlock Width="60" Height="9" VerticalAlignment="Center" />
    </StackPanel>
    <Border Style="{StaticResource HairlineRow}" Padding="0,11">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource CompactNameWidth}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <controls:SkeletonBlock Height="12" Width="90" HorizontalAlignment="Left" Shimmer="True" />
        <controls:SkeletonBlock Grid.Column="1" Height="8" CornerRadius="4" Shimmer="True" VerticalAlignment="Center" />
        <controls:SkeletonBlock Grid.Column="2" Height="8" CornerRadius="4" Shimmer="True" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Style="{StaticResource HairlineRow}" Padding="0,11">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource CompactNameWidth}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <controls:SkeletonBlock Height="12" Width="70" HorizontalAlignment="Left" Shimmer="True" />
        <controls:SkeletonBlock Grid.Column="1" Height="8" CornerRadius="4" Shimmer="True" VerticalAlignment="Center" />
        <controls:SkeletonBlock Grid.Column="2" Height="8" CornerRadius="4" Shimmer="True" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
