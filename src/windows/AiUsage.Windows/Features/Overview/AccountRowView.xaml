<UserControl
    x:Class="AiUsage.Features.Overview.AccountRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:accounts="using:AiUsage.Features.Accounts"
    xmlns:platform="using:AiUsage.Platform"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    FocusVisualPrimaryBrush="{ThemeResource FocusBrush}"
    FocusVisualPrimaryThickness="2"
    FocusVisualSecondaryThickness="0"
    CanDrag="True"
    AllowDrop="True"
    AutomationProperties.AutomationId="{x:Bind AutomationIdFor(Row.Id), Mode=OneWay}"
    AutomationProperties.Name="{x:Bind Row.AccessibleName, Mode=OneWay}"
    AutomationProperties.PositionInSet="{x:Bind Row.Position, Mode=OneWay}">
  <!-- D-181 compact row: label and one status mark, one bar per window, sign-out at the right edge. Details are hover text. -->
  <Border x:Name="RowBorder" Style="{StaticResource HairlineRow}" Padding="{x:Bind CompactPadding(platform:AppLayout.Current.CompactDensity), Mode=OneWay}"
          Opacity="{x:Bind controls:Bind.Opacity(Row.IsDisconnected), Mode=OneWay}" Background="Transparent">
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource CompactNameWidth}" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="30" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button AutomationProperties.AutomationId="RowOpen" Style="{StaticResource LinkButton}" Foreground="{ThemeResource TextBrush}" FontSize="13" Padding="0"
                Command="{x:Bind Row.OpenCommand}" AutomationProperties.Name="{x:Bind Row.Label, Mode=OneWay}" MaxWidth="104" IsTabStop="False"
                ToolTipService.ToolTip="{x:Bind Row.Label, Mode=OneWay}">
          <TextBlock Text="{x:Bind Row.Label, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </Button>
        <Button AutomationProperties.AutomationId="RowStatus" Style="{StaticResource GhostIconButton}" Width="20" Height="20" Command="{x:Bind Row.StatusActionCommand}"
                Visibility="{x:Bind controls:Bind.Visible(Row.HasStatus), Mode=OneWay}" AutomationProperties.Name="{x:Bind Row.StatusText, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Row.StatusText, Mode=OneWay}">
          <FontIcon Glyph="{x:Bind StatusGlyph(Row.Status), Mode=OneWay}" FontSize="12" controls:Tokens.Foreground="{x:Bind controls:Bind.ToneKey(Row.StatusTone), Mode=OneWay}" />
        </Button>
        <Button AutomationProperties.AutomationId="RowRefresh" Style="{StaticResource GhostIconButton}" Width="20" Height="20"
                Command="{x:Bind RefreshAction(Row.IsRefreshing), Mode=OneWay}" AutomationProperties.Name="{x:Bind Row.RefreshName, Mode=OneWay}"
                Opacity="{x:Bind RevealOpacity(Row.IsHovered, Row.IsRefreshing), Mode=OneWay}">
          <controls:RefreshGlyph IsSpinning="{x:Bind Row.IsRefreshing, Mode=OneWay}" Foreground="{ThemeResource Text2Brush}" />
        </Button>
        <TextBlock Text="{x:Bind Row.HiddenTag, Mode=OneWay}" Style="{StaticResource Caption11Text}" VerticalAlignment="Center"
                   Visibility="{x:Bind controls:Bind.Visible(Row.HasHiddenTag), Mode=OneWay}" />
      </StackPanel>

      <!-- One bar per window of the primary group; stale readings are dimmed so they never look current. -->
      <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind Row.Windows}" VerticalAlignment="Center"
                     Visibility="{x:Bind controls:Bind.Visible(Row.ShowBars), Mode=OneWay}" Opacity="{x:Bind StaleOpacity(Row.IsStale), Mode=OneWay}">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="40" MinColumnSpacing="16" ItemsStretch="Fill" MaximumRowsOrColumns="{x:Bind controls:Bind.AtLeastOne(Row.Windows.Count), Mode=OneWay}" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="accounts:QuotaWindowViewModel">
            <Grid ColumnSpacing="8" MinHeight="20" Background="Transparent" ToolTipService.ToolTip="{x:Bind HintText, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:QuotaMeter BarHeight="8" VerticalAlignment="Center" Kind="{x:Bind Kind, Mode=OneWay}" Tone="{x:Bind PaceTone, Mode=OneWay}"
                                   Observation="{x:Bind Observation, Mode=OneWay}" Fraction="{x:Bind Fraction, Mode=OneWay}"
                                   PaceMark="{x:Bind PaceMark, Mode=OneWay}" PaceSplit="{x:Bind PaceSplit, Mode=OneWay}" />
              <TextBlock Grid.Column="1" Text="{x:Bind BackInText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource CritBrush}" VerticalAlignment="Center"
                         Visibility="{x:Bind controls:Bind.Visible(HasBackIn), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>

      <!-- Signed out or sign-in expired: the bars give way to one prompt with the inline sign-in. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(Row.ShowSignInPrompt), Mode=OneWay}">
        <TextBlock Text="{x:Bind Row.SignInPrompt, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
        <Button x:Uid="Row_SignIn" AutomationProperties.AutomationId="RowSignIn" Style="{StaticResource SmallLinkButton}" Padding="0" Command="{x:Bind Row.ReconnectCommand}"
                AutomationProperties.Name="{x:Bind Row.SignInName, Mode=OneWay}" />
      </StackPanel>

      <TextBlock Grid.Column="1" Text="{x:Bind Row.NoPrimaryText, Mode=OneWay}" Style="{StaticResource Caption11Text}" VerticalAlignment="Center"
                 Visibility="{x:Bind controls:Bind.Visible(Row.ShowNoPrimary), Mode=OneWay}" />

      <!-- Right edge: sign out, icon only, immediate, keeps history. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button AutomationProperties.AutomationId="RowSignOut" Style="{StaticResource GhostIconButton}" Width="28" Height="28" Command="{x:Bind Row.SignOutCommand}"
                Visibility="{x:Bind controls:Bind.Collapsed(Row.IsDisconnected), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind Row.SignOutName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Row.SignOutName, Mode=OneWay}">
          <FontIcon Glyph="&#xF3B1;" FontSize="14" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
