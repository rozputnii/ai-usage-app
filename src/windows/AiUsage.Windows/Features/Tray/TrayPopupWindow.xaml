<Window
    x:Class="AiUsage.Features.Tray.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:tray="using:AiUsage.Features.Tray">
  <!-- S07 tray mini-dashboard: severity-sorted rows, per-row refresh and open, Refresh all; never charts. -->
  <Grid x:Name="PopupRoot" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource Stroke2Brush}" BorderThickness="1" AutomationProperties.AutomationId="TrayPopup" KeyDown="OnKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Padding="14,12,10,6" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="12" Height="12" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Uid="AppTitleText" Style="{StaticResource Body13StrongText}" TextWrapping="NoWrap" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource Caption11Text}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.AutomationId="TrayCount" />
      <Button Grid.Column="3" x:Uid="Tray_RefreshAll" AutomationProperties.AutomationId="TrayRefreshAll" Style="{StaticResource GhostIconButton}" Width="26" Height="26" Command="{x:Bind ViewModel.RefreshAllCommand}">
        <controls:RefreshGlyph IsSpinning="{x:Bind ViewModel.IsRefreshingAll, Mode=OneWay}" Foreground="{ThemeResource Text2Brush}" />
      </Button>
      <Button Grid.Column="4" x:Uid="Tray_Close" AutomationProperties.AutomationId="TrayClose" Style="{StaticResource GhostIconButton}" Width="26" Height="26" Command="{x:Bind ViewModel.ClosePopupCommand}">
        <TextBlock Text="✕" FontSize="12" />
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="14,0">
      <StackPanel>
        <TextBlock Text="{x:Bind ViewModel.ToolTip, Mode=OneWay}" Style="{StaticResource CaptionText}" Padding="0,8" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows}" AutomationProperties.AutomationId="TrayRows">
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="tray:TrayRowViewModel">
              <Border Style="{StaticResource HairlineRow}" Padding="0,7">
                <Grid ColumnSpacing="10" RowSpacing="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="26" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <controls:ProviderTile ProviderId="{x:Bind ProviderId, Mode=OneWay}" TileSize="22" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Style="{StaticResource LinkButton}" Foreground="{ThemeResource TextBrush}" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Command="{x:Bind OpenCommand}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <StackPanel>
                      <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <TextBlock Text="{x:Bind SubText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource Text2Brush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                  </Button>
                  <TextBlock Grid.Column="2" Text="{x:Bind ValueText, Mode=OneWay}" FontSize="15" VerticalAlignment="Center" controls:Tokens.Foreground="{x:Bind controls:Bind.ToneKey(Tone), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" />
                  <Button Grid.Column="3" Style="{StaticResource GhostIconButton}" Width="26" Height="26" Command="{x:Bind RefreshCommand}" AutomationProperties.Name="{x:Bind RefreshName, Mode=OneWay}">
                    <controls:RefreshGlyph GlyphSize="12" IsSpinning="{x:Bind IsRefreshing, Mode=OneWay}" Foreground="{ThemeResource Text2Brush}" />
                  </Button>
                  <controls:QuotaMeter Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" BarHeight="3" Margin="0,-4,0,0" Visibility="{x:Bind controls:Bind.Visible(HasMeter), Mode=OneWay}"
                                       Kind="{x:Bind Primary.Kind, Mode=OneWay}" Tone="{x:Bind Primary.Tone, Mode=OneWay}" Fraction="{x:Bind Primary.Fraction, Mode=OneWay}" Observation="{x:Bind Primary.Observation, Mode=OneWay}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource HairlineRow}" Margin="14,0" Padding="0,8,0,12">
      <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="4">
        <Button x:Uid="Tray_OpenDashboard" AutomationProperties.AutomationId="TrayOpenDashboard" Style="{StaticResource SmallLinkButton}" Padding="0" Command="{x:Bind ViewModel.OpenDashboardCommand}" />
        <Button x:Uid="Tray_Settings" AutomationProperties.AutomationId="TraySettings" Style="{StaticResource SmallLinkButton}" Padding="0" Command="{x:Bind ViewModel.OpenSettingsCommand}" />
        <TextBlock x:Uid="Tray_Footer" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
      </controls:WrapPanel>
    </Border>
  </Grid>
</Window>
