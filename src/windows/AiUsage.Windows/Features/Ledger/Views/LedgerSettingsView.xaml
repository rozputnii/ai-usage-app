<UserControl
    x:Class="AiUsage.Features.Ledger.Views.LedgerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ledger="using:AiUsage.Features.Ledger"
    xmlns:contract="using:AiUsage.Features.Ledger.Contract"
    xmlns:lc="using:AiUsage.Controls.Ledger"
    xmlns:views="using:AiUsage.Features.Ledger.Views"
    IsTabStop="False">
  <UserControl.Resources>
    <Storyboard x:Name="InstallDotsMotion" RepeatBehavior="Forever">
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="InstallDots" Storyboard.TargetProperty="Text">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="" />
        <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="." />
        <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value=".." />
        <DiscreteObjectKeyFrame KeyTime="0:0:0.9" Value="..." />
        <DiscreteObjectKeyFrame KeyTime="0:0:1.2" Value="..." />
      </ObjectAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>
  <!--
    S5 (R-193, R-197): a floating sheet over the window body, lighter than the page and the cards, inset from the window edges. Tiny labels name the
    groups; explanations are tooltips. Rare support actions and Delete stored data sit in the footer's ⋯ menu.
  -->
  <Grid Padding="8">
    <lc:SquircleSurface Radius="14" Fill="{StaticResource LedgerPanelBrush}" Stroke="{StaticResource LedgerLineWindowBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
          <StackPanel Padding="14,8,8,12" Spacing="14" AutomationProperties.Name="Settings" AutomationProperties.LandmarkType="Custom">
            <StackPanel Spacing="6" Margin="0,0,6,0" Visibility="{x:Bind Show(ViewModel.NeedsRecovery), Mode=OneWay}">
              <TextBlock Text="{x:Bind ViewModel.RecoveryText, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <lc:LedgerButton Style="{StaticResource LedgerOutlineButton}" Content="Retry" Command="{x:Bind ViewModel.SupportCommand}" CommandParameter="{x:Bind contract:LedgerSupportAction.RetryRecovery}"
                        IsEnabled="{x:Bind ViewModel.CanRetryRecovery, Mode=OneWay}" AutomationProperties.Name="Retry recovery" />
                <lc:LedgerButton Style="{StaticResource LedgerOutlineButton}" Content="Restore preferences" Command="{x:Bind ViewModel.SupportCommand}" CommandParameter="{x:Bind contract:LedgerSupportAction.RestorePreferences}"
                        IsEnabled="{x:Bind ViewModel.CanRestorePreferences, Mode=OneWay}" AutomationProperties.Name="Restore legacy preferences"
                        ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Old appearance preferences only; sign-ins and quota history cannot be restored')}" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid>
                <TextBlock Text="Work days" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(ViewModel.WorkDaysNote)}" />
                <lc:LedgerButton Style="{StaticResource LedgerIconButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.Owner.ToggleSettingsCommand}"
                        AutomationProperties.Name="Close settings">
                  <Path Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" Stroke="{StaticResource LedgerInk2Brush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" />
                </lc:LedgerButton>
              </Grid>
              <ItemsControl ItemsSource="{x:Bind ViewModel.WorkDays}" IsEnabled="{x:Bind ViewModel.Owner.CanUseAccounts, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Work days">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ledger:WorkDayToggle">
                    <lc:LedgerButton Content="{x:Bind Label}" Width="34" Padding="0,3,0,3" Command="{x:Bind ToggleCommand}" Style="{StaticResource LedgerButtonBase}"
                            Background="{x:Bind views:LedgerSettingsView.DayBackground(IsOn), Mode=OneWay}" BorderBrush="{x:Bind views:LedgerSettingsView.DayBorder(IsOn), Mode=OneWay}"
                            BorderThickness="1" Foreground="{x:Bind views:LedgerSettingsView.DayForeground(IsOn), Mode=OneWay}"
                            FontWeight="{x:Bind views:LedgerSettingsView.DayWeight(IsOn), Mode=OneWay}"
                            FontFamily="{x:Bind views:LedgerSettingsView.DayFont(IsOn), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,0,6,0" Visibility="{x:Bind Show(ViewModel.HasCaps), Mode=OneWay}">
              <TextBlock Text="Caps" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Left" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(ViewModel.CapsNote)}" />
              <ItemsControl ItemsSource="{x:Bind ViewModel.Caps}" IsEnabled="{x:Bind ViewModel.Owner.CanUseAccounts, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ledger:CapRow">
                    <StackPanel AutomationProperties.Name="{x:Bind AccessibleName}">
                      <Grid ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(Note)}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource LedgerBodyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="12" Foreground="{StaticResource LedgerAttTextBrush}"
                                  Visibility="{x:Bind views:LedgerSettingsView.Present(IsWarning)}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind AmountText}" Style="{StaticResource LedgerStrongText}" VerticalAlignment="Center"
                                   Foreground="{x:Bind views:LedgerSettingsView.AmountBrush(IsApplied)}" />
                        <lc:LedgerButton Grid.Column="3" Style="{StaticResource LedgerIconButton}" Command="{x:Bind ActCommand}" IsEnabled="{x:Bind CanAct}"
                                AutomationProperties.Name="{x:Bind ActionText}">
                          <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind views:LedgerSettingsView.ActionGlyph(ActionText)}" FontSize="12" Foreground="{StaticResource LedgerInk2Brush}" />
                        </lc:LedgerButton>
                      </Grid>
                      <lc:CapEditorView Editor="{x:Bind Editor, Mode=OneWay}" Margin="0,4,0,4"
                                        Visibility="{x:Bind views:LedgerSettingsView.Present(IsEditing), Mode=OneWay}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="6" Margin="0,0,6,0">
              <TextBlock Text="View" Style="{StaticResource LedgerCaptionText}" />
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <lc:LedgerButton IsEnabled="{x:Bind ViewModel.Owner.CanUseAccounts, Mode=OneWay}" Content="Compact" Style="{StaticResource LedgerSegmentButton}" Click="OnCompact" Background="{x:Bind Segment(ViewModel.IsCompact, x:True), Mode=OneWay}"
                            Foreground="{x:Bind SegmentText(ViewModel.IsCompact, x:True), Mode=OneWay}" AutomationProperties.Name="Density: compact" />
                    <lc:LedgerButton IsEnabled="{x:Bind ViewModel.Owner.CanUseAccounts, Mode=OneWay}" Content="Comfortable" Style="{StaticResource LedgerSegmentButton}" Click="OnComfortable" Background="{x:Bind Segment(ViewModel.IsCompact, x:False), Mode=OneWay}"
                            Foreground="{x:Bind SegmentText(ViewModel.IsCompact, x:False), Mode=OneWay}" AutomationProperties.Name="Density: comfortable" />
                  </StackPanel>
                </Border>
                <lc:LedgerButton Grid.Column="1" IsEnabled="{x:Bind ViewModel.Owner.CanUseAccounts, Mode=OneWay}" Style="{StaticResource LedgerFooterButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.ToggleAlwaysOnTopCommand}"
                        AutomationProperties.Name="{x:Bind SwitchName('Always on top', ViewModel.AlwaysOnTop), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Always on top')}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE718;" FontSize="14" Foreground="{StaticResource LedgerInk2Brush}" VerticalAlignment="Center" />
                    <Grid Width="32" Height="18">
                      <lc:SquircleSurface Radius="9" Stroke="{x:Bind SwitchTrack(ViewModel.AlwaysOnTop), Mode=OneWay}" Fill="{x:Bind SwitchFill(ViewModel.AlwaysOnTop), Mode=OneWay}" />
                      <Ellipse Width="10" Height="10" Margin="4,0,4,0" Fill="{x:Bind SwitchKnob(ViewModel.AlwaysOnTop), Mode=OneWay}"
                               HorizontalAlignment="{x:Bind KnobSide(ViewModel.AlwaysOnTop), Mode=OneWay}" />
                    </Grid>
                  </StackPanel>
                </lc:LedgerButton>
              </Grid>
              <!-- T-055 R-11: [−] N min [+], 1 to 60 whole minutes, each change saved at once; the box takes digits and saves on Enter or when focus leaves it. -->
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Refresh" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
                <ContentControl Grid.Column="1" IsTabStop="False" IsEnabled="{x:Bind ViewModel.Owner.CanUseAccounts, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(ViewModel.RefreshTip), Mode=OneWay}">
                    <lc:LedgerButton Style="{StaticResource LedgerIconButton}" Command="{x:Bind ViewModel.DecreaseRefreshCommand}" AutomationProperties.Name="Shorter refresh interval">
                      <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE738;" FontSize="12" Foreground="{StaticResource LedgerInk2Brush}" />
                    </lc:LedgerButton>
                    <TextBox x:Name="RefreshBox" Style="{StaticResource LedgerAmountBox}" Width="36" TextAlignment="Center" Text="{x:Bind ViewModel.RefreshText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             BeforeTextChanging="OnRefreshBeforeChanging" KeyDown="OnRefreshKeyDown" LostFocus="OnRefreshLostFocus" AutomationProperties.Name="Refresh interval in minutes">
                      <TextBox.Resources><x:Double x:Key="TextControlThemeMinHeight">24</x:Double><x:Double x:Key="TextControlThemeMinWidth">36</x:Double></TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="min" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
                    <lc:LedgerButton Style="{StaticResource LedgerIconButton}" Command="{x:Bind ViewModel.IncreaseRefreshCommand}" AutomationProperties.Name="Longer refresh interval">
                      <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource LedgerInk2Brush}" />
                    </lc:LedgerButton>
                  </StackPanel>
                </ContentControl>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6" Margin="0,0,6,0">
              <Grid ColumnSpacing="8">
                <TextBlock Text="Updates" Style="{StaticResource LedgerCaptionText}" />
                <TextBlock Text="{x:Bind ViewModel.UpdateVersionText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Right"
                           ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(ViewModel.UpdatesText), Mode=OneWay}" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Border HorizontalAlignment="Left" Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <lc:LedgerButton Content="Off" Style="{StaticResource LedgerSegmentButton}" Click="OnUpdatesOff" Background="{x:Bind Segment(ViewModel.IsUpdateOff, x:True), Mode=OneWay}"
                            Foreground="{x:Bind SegmentText(ViewModel.IsUpdateOff, x:True), Mode=OneWay}" AutomationProperties.Name="Automatic updates: off"
                            ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('No automatic update checks')}" />
                    <lc:LedgerButton Content="On launch" Style="{StaticResource LedgerSegmentButton}" Click="OnUpdatesOnLaunch" Background="{x:Bind Segment(ViewModel.IsUpdateOnLaunch, x:True), Mode=OneWay}"
                            Foreground="{x:Bind SegmentText(ViewModel.IsUpdateOnLaunch, x:True), Mode=OneWay}" AutomationProperties.Name="Automatic updates: on launch"
                            ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Check once after the app starts')}" />
                    <lc:LedgerButton Content="Always" Style="{StaticResource LedgerSegmentButton}" Click="OnUpdatesAlways" Background="{x:Bind Segment(ViewModel.IsUpdateAlways, x:True), Mode=OneWay}"
                            Foreground="{x:Bind SegmentText(ViewModel.IsUpdateAlways, x:True), Mode=OneWay}" AutomationProperties.Name="Automatic updates: always"
                            ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Check every 5 minutes')}" />
                  </StackPanel>
                </Border>
                <lc:LedgerButton Style="{StaticResource LedgerIconButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                        Visibility="{x:Bind Show(ViewModel.CanCheckUpdates), Mode=OneWay}" AutomationProperties.Name="Check for updates">
                  <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource LedgerInk2Brush}" />
                </lc:LedgerButton>
              </Grid>
              <TextBlock Text="{x:Bind ViewModel.UpdatesText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" Visibility="{x:Bind Show(ViewModel.IsUpdateNotable), Mode=OneWay}" />
              <!-- While installing, the button stays, dims and counts dots until Windows closes the app. -->
              <lc:LedgerButton Style="{StaticResource LedgerPrimaryButton}" HorizontalAlignment="Left" Command="{x:Bind ViewModel.InstallUpdateCommand}"
                      IsEnabled="{x:Bind Not(ViewModel.IsInstallingUpdate), Mode=OneWay}" Visibility="{x:Bind Show(ViewModel.CanInstallUpdate), Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind ViewModel.InstallUpdateText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{x:Bind ViewModel.InstallUpdateText, Mode=OneWay}" />
                  <TextBlock x:Name="InstallDots" Text="…" Width="12" Visibility="{x:Bind Show(ViewModel.IsInstallingUpdate), Mode=OneWay}" />
                </StackPanel>
              </lc:LedgerButton>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.SupportStatus, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" Margin="0,0,6,0"
                       Visibility="{x:Bind ShowText(ViewModel.SupportStatus), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.DiagnosticText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,0,6,0"
                       Visibility="{x:Bind ShowText(ViewModel.DiagnosticText), Mode=OneWay}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Footer: a status problem, if any, and the ⋯ menu; arming Delete shows Confirm · Cancel here. -->
        <StackPanel Grid.Row="1" Padding="14,6,8,8" Spacing="6" BorderBrush="{StaticResource LedgerLineWindowBrush}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="6" Visibility="{x:Bind Show(ViewModel.IsDeleteArmed), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.DeleteNote}" Style="{StaticResource LedgerBodyText}" Foreground="{StaticResource LedgerCritTextBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <lc:LedgerButton x:Name="ConfirmButton" Content="Delete" Style="{StaticResource LedgerDangerButton}" Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                      AutomationProperties.Name="Confirm deleting stored data" />
              <lc:LedgerButton x:Name="CancelButton" Content="Cancel" Style="{StaticResource LedgerOutlineButton}" Command="{x:Bind ViewModel.CancelDeleteCommand}"
                      AutomationProperties.Name="Cancel deleting stored data" />
            </StackPanel>
          </StackPanel>
          <Grid ColumnSpacing="8">
            <TextBlock Text="{x:Bind ViewModel.SystemStatusText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" Foreground="{StaticResource LedgerAttTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,32,0" Visibility="{x:Bind Show(ViewModel.HasSystemStatus), Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(ViewModel.SystemStatusText), Mode=OneWay}" />
            <lc:LedgerButton x:Name="MoreButton" Style="{StaticResource LedgerIconButton}" HorizontalAlignment="Right" AutomationProperties.Name="More settings"
                    ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Diagnostics, logs and data')}">
              <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE712;" FontSize="14" Foreground="{StaticResource LedgerInk2Brush}" />
              <lc:LedgerButton.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight">
                  <MenuFlyoutItem Text="Preview diagnostics" Command="{x:Bind ViewModel.PreviewDiagnosticsCommand}" />
                  <MenuFlyoutItem Text="Open logs" Command="{x:Bind ViewModel.SupportCommand}" CommandParameter="{x:Bind contract:LedgerSupportAction.OpenLogs}" />
                  <MenuFlyoutItem Text="Open data folder" Command="{x:Bind ViewModel.SupportCommand}" CommandParameter="{x:Bind contract:LedgerSupportAction.OpenDataFolder}" />
                  <MenuFlyoutItem Text="Export recovery summary" Command="{x:Bind ViewModel.SupportCommand}" CommandParameter="{x:Bind contract:LedgerSupportAction.ExportRecovery}" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="Delete stored data…" Command="{x:Bind ViewModel.ArmDeleteCommand}" AutomationProperties.Name="Delete stored data"
                                  ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('History saved by older versions is kept separately and deleted too')}" />
                </MenuFlyout>
              </lc:LedgerButton.Flyout>
            </lc:LedgerButton>
          </Grid>
        </StackPanel>
      </Grid>
    </lc:SquircleSurface>
  </Grid>
</UserControl>
