<UserControl
    x:Class="AiUsage.Features.Ledger.Views.LedgerSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ledger="using:AiUsage.Features.Ledger"
    xmlns:lc="using:AiUsage.Controls.Ledger"
    xmlns:views="using:AiUsage.Features.Ledger.Views"
    IsTabStop="False">
  <!-- S5: the inline settings panel beside the cards; System status stays last (D-180). -->
  <Border Background="{StaticResource LedgerPanelBrush}" BorderBrush="{StaticResource LedgerLineCardBrush}" BorderThickness="1,0,0,0">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
      <StackPanel Padding="16,14,16,18" Spacing="16" AutomationProperties.Name="Settings" AutomationProperties.LandmarkType="Custom">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Settings" Style="{StaticResource LedgerCardNameText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="Esc closes" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Style="{StaticResource LedgerIconButton}" Background="{StaticResource LedgerLineBrush}" Command="{x:Bind ViewModel.Owner.ToggleSettingsCommand}"
                  AutomationProperties.Name="Close settings">
            <Path Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5" Stroke="{StaticResource LedgerInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" />
          </Button>
        </Grid>

        <StackPanel Spacing="8">
          <TextBlock Text="BUDGET" Style="{StaticResource LedgerSectionText}" />
          <TextBlock Text="Work days" Style="{StaticResource LedgerStrongText}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.WorkDays}" IsTabStop="False" AutomationProperties.Name="Work days">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ledger:WorkDayToggle">
                <Button Content="{x:Bind Label}" Width="44" Padding="0,3,0,3" Command="{x:Bind ToggleCommand}" Style="{StaticResource LedgerButtonBase}"
                        Background="{x:Bind views:LedgerSettingsView.DayBackground(IsOn), Mode=OneWay}" BorderBrush="{x:Bind views:LedgerSettingsView.DayBorder(IsOn), Mode=OneWay}"
                        BorderThickness="1" Foreground="{x:Bind views:LedgerSettingsView.DayForeground(IsOn), Mode=OneWay}"
                        FontWeight="{x:Bind views:LedgerSettingsView.DayWeight(IsOn), Mode=OneWay}"
                        FontFamily="{x:Bind views:LedgerSettingsView.DayFont(IsOn), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{x:Bind ViewModel.WorkDaysNote}" Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="PERSONAL CAPS" Style="{StaticResource LedgerSectionText}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.Caps}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ledger:CapRow">
                <StackPanel Spacing="2" AutomationProperties.Name="{x:Bind AccessibleName}">
                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource LedgerBodyText}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind AmountText}" Style="{StaticResource LedgerStrongText}"
                               Foreground="{x:Bind views:LedgerSettingsView.AmountBrush(IsApplied)}" />
                    <Button Grid.Column="2" Content="{x:Bind ActionText}" Style="{StaticResource LedgerLinkButton}" Command="{x:Bind ActCommand}" IsEnabled="{x:Bind CanAct}"
                            AutomationProperties.Name="{x:Bind ActionText}" />
                  </Grid>
                  <TextBlock Text="{x:Bind Note}" Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap"
                             Foreground="{x:Bind views:LedgerSettingsView.NoteBrush(IsWarning)}" />
                  <lc:CapEditorView Editor="{x:Bind Editor, Mode=OneWay}" Margin="0,4,0,0"
                                    Visibility="{x:Bind views:LedgerSettingsView.Present(IsEditing), Mode=OneWay}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No personal caps set." Style="{StaticResource LedgerCaptionText}" Visibility="{x:Bind Hide(ViewModel.HasCaps), Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.CapsNote}" Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="APPEARANCE" Style="{StaticResource LedgerSectionText}" />
          <Grid>
            <TextBlock Text="Show values" Style="{StaticResource LedgerBodyText}" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="Used" Style="{StaticResource LedgerSegmentButton}" Click="OnUsed" Background="{x:Bind Segment(ViewModel.IsLeft, x:False), Mode=OneWay}"
                        Foreground="{x:Bind SegmentText(ViewModel.IsLeft, x:False), Mode=OneWay}" AutomationProperties.Name="Show values: used" />
                <Button Content="Left" Style="{StaticResource LedgerSegmentButton}" Click="OnLeft" Background="{x:Bind Segment(ViewModel.IsLeft, x:True), Mode=OneWay}"
                        Foreground="{x:Bind SegmentText(ViewModel.IsLeft, x:True), Mode=OneWay}" AutomationProperties.Name="Show values: left" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid>
            <TextBlock Text="Density" Style="{StaticResource LedgerBodyText}" VerticalAlignment="Center" />
            <Border HorizontalAlignment="Right" Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="Compact" Style="{StaticResource LedgerSegmentButton}" Click="OnCompact" Background="{x:Bind Segment(ViewModel.IsCompact, x:True), Mode=OneWay}"
                        Foreground="{x:Bind SegmentText(ViewModel.IsCompact, x:True), Mode=OneWay}" AutomationProperties.Name="Density: compact" />
                <Button Content="Comfortable" Style="{StaticResource LedgerSegmentButton}" Click="OnComfortable" Background="{x:Bind Segment(ViewModel.IsCompact, x:False), Mode=OneWay}"
                        Foreground="{x:Bind SegmentText(ViewModel.IsCompact, x:False), Mode=OneWay}" AutomationProperties.Name="Density: comfortable" />
              </StackPanel>
            </Border>
          </Grid>
          <Button Style="{StaticResource LedgerFooterButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{x:Bind ViewModel.ToggleShowSignedOutCommand}"
                  AutomationProperties.Name="{x:Bind SwitchName('Show signed-out accounts', ViewModel.ShowSignedOut), Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Show signed-out accounts" Style="{StaticResource LedgerBodyText}" />
              <TextBlock Grid.Column="1" Text="{x:Bind OnOff(ViewModel.ShowSignedOut), Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" />
              <Grid Grid.Column="2" Width="32" Height="18">
                <lc:SquircleSurface Radius="9" Stroke="{x:Bind SwitchTrack(ViewModel.ShowSignedOut), Mode=OneWay}" Fill="{x:Bind SwitchFill(ViewModel.ShowSignedOut), Mode=OneWay}" />
                <Ellipse Width="10" Height="10" Margin="4,0,4,0" Fill="{x:Bind SwitchKnob(ViewModel.ShowSignedOut), Mode=OneWay}"
                         HorizontalAlignment="{x:Bind KnobSide(ViewModel.ShowSignedOut), Mode=OneWay}" />
              </Grid>
            </Grid>
          </Button>
          <Button Style="{StaticResource LedgerFooterButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{x:Bind ViewModel.ToggleAlwaysOnTopCommand}"
                  AutomationProperties.Name="{x:Bind SwitchName('Always on top', ViewModel.AlwaysOnTop), Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Always on top" Style="{StaticResource LedgerBodyText}" />
              <TextBlock Grid.Column="1" Text="{x:Bind OnOff(ViewModel.AlwaysOnTop), Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" />
              <Grid Grid.Column="2" Width="32" Height="18">
                <lc:SquircleSurface Radius="9" Stroke="{x:Bind SwitchTrack(ViewModel.AlwaysOnTop), Mode=OneWay}" Fill="{x:Bind SwitchFill(ViewModel.AlwaysOnTop), Mode=OneWay}" />
                <Ellipse Width="10" Height="10" Margin="4,0,4,0" Fill="{x:Bind SwitchKnob(ViewModel.AlwaysOnTop), Mode=OneWay}"
                         HorizontalAlignment="{x:Bind KnobSide(ViewModel.AlwaysOnTop), Mode=OneWay}" />
              </Grid>
            </Grid>
          </Button>
        </StackPanel>

        <Grid ColumnSpacing="8">
          <TextBlock Text="MONITORING &amp; NOTIFICATIONS" Style="{StaticResource LedgerSectionText}" />
          <TextBlock Text="{x:Bind ViewModel.MonitoringText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Spacing="8">
          <TextBlock Text="DATA &amp; PRIVACY" Style="{StaticResource LedgerSectionText}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Delete stored data" Style="{StaticResource LedgerBodyText}" VerticalAlignment="Center" />
            <Button x:Name="DeleteButton" Grid.Column="1" Content="Delete…" Style="{StaticResource LedgerOutlineButton}" Command="{x:Bind ViewModel.ArmDeleteCommand}"
                    Visibility="{x:Bind Hide(ViewModel.IsDeleteArmed), Mode=OneWay}" AutomationProperties.Name="Delete stored data" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Show(ViewModel.IsDeleteArmed), Mode=OneWay}">
              <Button x:Name="ConfirmButton" Content="Confirm" Style="{StaticResource LedgerDangerButton}" Command="{x:Bind ViewModel.ConfirmDeleteCommand}"
                      AutomationProperties.Name="Confirm deleting stored data" />
              <TextBlock Text="·" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
              <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource LedgerOutlineButton}" Command="{x:Bind ViewModel.CancelDeleteCommand}"
                      AutomationProperties.Name="Cancel deleting stored data" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.DeleteNote}" Style="{StaticResource LedgerBodyText}" Foreground="{StaticResource LedgerCritTextBrush}" TextWrapping="Wrap"
                     Visibility="{x:Bind Show(ViewModel.IsDeleteArmed), Mode=OneWay}" />
        </StackPanel>

        <Grid ColumnSpacing="8">
          <TextBlock Text="UPDATES" Style="{StaticResource LedgerSectionText}" />
          <TextBlock Text="{x:Bind ViewModel.UpdatesText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Right" />
        </Grid>
        <Grid ColumnSpacing="8">
          <TextBlock Text="SYSTEM STATUS" Style="{StaticResource LedgerSectionText}" />
          <TextBlock Text="{x:Bind ViewModel.SystemStatusText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
