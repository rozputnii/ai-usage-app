<UserControl
    x:Class="AiUsage.Features.Ledger.Views.LedgerCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ledger="using:AiUsage.Features.Ledger"
    xmlns:lc="using:AiUsage.Controls.Ledger"
    IsTabStop="False"
    CornerRadius="20"
    AutomationProperties.Name="{x:Bind ViewModel.Visual.AccessibleName, Mode=OneWay}"
    AutomationProperties.AutomationId="{x:Bind ViewModel.CardId, Mode=OneWay}"
    KeyDown="OnKeyDown">
  <!-- Spec 6.2: name, scope, marks and pill; then the today row, the period row and the footer, or fact lines. -->
  <lc:SquircleSurface x:Name="Surface" Radius="20" Fill="{x:Bind SurfaceFill(ViewModel.IsNew, ViewModel.IsAccountSection), Mode=OneWay}" Stroke="{x:Bind SurfaceStroke(ViewModel.IsNew, ViewModel.IsAccountSection), Mode=OneWay}"
                      Padding="{x:Bind CardPadding(ViewModel.IsCompact, ViewModel.IsAccountSection), Mode=OneWay}">
    <StackPanel Spacing="{x:Bind InnerGap(ViewModel.IsCompact), Mode=OneWay}">
      <Grid ColumnSpacing="8" MinHeight="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <lc:ShrinkFirstPanel>
          <Grid>
          <!-- D-205: a click on the name renames the account, as F2 does; on hover it is underlined like the hidden count. -->
          <lc:LedgerClickRow x:Name="NameRow" IsTabStop="False" Background="Transparent" Tapped="OnNameTapped" PointerEntered="OnNamePointerEntered" PointerExited="OnNamePointerExited"
                             Visibility="{x:Bind NameVisibility(ViewModel.IsRenaming, ViewModel.IsAccountSection), Mode=OneWay}"
                             ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Rename')}">
            <Grid>
              <TextBlock Text="{x:Bind ViewModel.HeaderName, Mode=OneWay}" Style="{StaticResource LedgerCardNameText}" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Foreground="{x:Bind NameBrush(ViewModel.IsStale), Mode=OneWay}" SizeChanged="OnNameSizeChanged" />
              <Line x:Name="NameUnderline" Y1="0.5" Y2="0.5" VerticalAlignment="Bottom" Stroke="{StaticResource LedgerUnderlineBrush}" StrokeThickness="1" StrokeDashArray="1,2"
                    Margin="0,0,0,-2" Opacity="0" />
            </Grid>
          </lc:LedgerClickRow>
          <TextBox x:Name="RenameBox" Text="{x:Bind ViewModel.RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LedgerNameBox}"
                 Visibility="{x:Bind Show(ViewModel.IsRenaming), Mode=OneWay}" KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" MinWidth="150"
                 AutomationProperties.Name="Account name">
            <!-- The template's border keeps a 32 px theme minimum that the 26 px box would clip at the bottom. -->
            <TextBox.Resources><x:Double x:Key="TextControlThemeMinHeight">26</x:Double></TextBox.Resources>
          </TextBox>
          </Grid>
          <TextBlock Text="{x:Bind ViewModel.Tag, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center"
                   Visibility="{x:Bind Show(ViewModel.HasTag), Mode=OneWay}" />
          <!-- D-191: hidden sections are counted on the account card; the dot keeps their most urgent colour. -->
          <lc:LedgerButton Style="{StaticResource LedgerFooterButton}" Command="{x:Bind ViewModel.ShowHiddenCommand}" VerticalAlignment="Center"
                  Visibility="{x:Bind Show(ViewModel.HasHidden), Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.HiddenName, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip(ViewModel.HiddenTip), Mode=OneWay}">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Ellipse Width="6" Height="6" Fill="{x:Bind PillDot(ViewModel.HiddenTone), Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.HiddenText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" />
              </StackPanel>
              <Line X1="0" X2="1" Stretch="Fill" VerticalAlignment="Bottom" Stroke="{StaticResource LedgerUnderlineBrush}" StrokeThickness="1" StrokeDashArray="1,2" Margin="0,0,0,-2" />
            </Grid>
          </lc:LedgerButton>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Visual.Marks, Mode=OneWay}" VerticalAlignment="Center" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ledger:MarkVisual">
              <TextBlock Text="{x:Bind Text}" Style="{StaticResource LedgerStrongText}" Foreground="{x:Bind lc:LedgerViews.MarkBrush(Neutral)}"
                         ToolTipService.ToolTip="{x:Bind lc:LedgerViews.Tip(Tip)}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </lc:ShrinkFirstPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
          <lc:LedgerButton Style="{StaticResource LedgerQuietIconButton}" PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited"
                  Command="{x:Bind ViewModel.HideCommand}" Visibility="{x:Bind Show(ViewModel.CanHide), Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.HideName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Hide')}">
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED1A;" FontSize="14" Foreground="{StaticResource LedgerInk2Brush}" />
          </lc:LedgerButton>
          <!-- D-199: units, today's use and the cap of this limit. -->
          <lc:LedgerButton x:Name="SettingsButton" Style="{StaticResource LedgerQuietIconButton}" PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited"
                  Visibility="{x:Bind Show(ViewModel.HasSettings), Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.SettingsName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Limit settings')}">
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9E9;" FontSize="14" Foreground="{StaticResource LedgerInk2Brush}" />
            <lc:LedgerButton.Flyout>
              <Flyout x:Name="SettingsFlyout" Placement="BottomEdgeAlignedRight" FlyoutPresenterStyle="{StaticResource LedgerFlyoutPresenter}"
                      Opening="OnSettingsOpening" Opened="OnSettingsOpened" Closed="OnSettingsClosed">
                <StackPanel Width="320" Spacing="12">
                  <StackPanel Spacing="5" Visibility="{x:Bind Show(ViewModel.Settings.HasUnits), Mode=OneWay, FallbackValue=Collapsed}">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="72" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="show as" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                          <lc:LedgerButton Content="credits" Style="{StaticResource LedgerSegmentButton}" Command="{x:Bind ViewModel.Settings.ShowCreditsCommand, Mode=OneWay}"
                                  Background="{x:Bind Segment(ViewModel.Settings.IsUsd, x:False), Mode=OneWay}" Foreground="{x:Bind SegmentText(ViewModel.Settings.IsUsd, x:False), Mode=OneWay}"
                                  AutomationProperties.Name="Show as credits" />
                          <lc:LedgerButton Content="USD" Style="{StaticResource LedgerSegmentButton}" Command="{x:Bind ViewModel.Settings.ShowUsdCommand, Mode=OneWay}"
                                  Background="{x:Bind Segment(ViewModel.Settings.IsUsd, x:True), Mode=OneWay}" Foreground="{x:Bind SegmentText(ViewModel.Settings.IsUsd, x:True), Mode=OneWay}"
                                  AutomationProperties.Name="Show as US dollars" />
                        </StackPanel>
                      </Border>
                      <TextBlock Grid.Column="3" Text="1 credit = $" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
                      <TextBox Grid.Column="4" Style="{StaticResource LedgerAmountBox}" Text="{x:Bind ViewModel.Settings.RateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                               BeforeTextChanging="OnRateBeforeChanging" KeyDown="OnRateKeyDown" AutomationProperties.Name="US dollars per credit"
                               ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Enter saves · GitHub charges $0.01 per AI credit')}">
                        <TextBox.Resources><x:Double x:Key="TextControlThemeMinHeight">24</x:Double></TextBox.Resources>
                      </TextBox>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.Settings.RateError, Mode=OneWay, FallbackValue=''}" Style="{StaticResource LedgerCaptionText}" Foreground="{StaticResource LedgerCritTextBrush}"
                               TextWrapping="Wrap" Visibility="{x:Bind ShowText(ViewModel.Settings.RateError), Mode=OneWay, FallbackValue=Collapsed}" />
                  </StackPanel>
                  <lc:CapEditorView AutoFocus="False" Editor="{x:Bind ViewModel.Settings.Today, Mode=OneWay}"
                                    Visibility="{x:Bind ShowEditor(ViewModel.Settings.Today), Mode=OneWay, FallbackValue=Collapsed}" />
                  <lc:CapEditorView x:Name="SettingsCapEditor" AutoFocus="False" Editor="{x:Bind ViewModel.Settings.Cap, Mode=OneWay}"
                                    Visibility="{x:Bind ShowEditor(ViewModel.Settings.Cap), Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>
              </Flyout>
            </lc:LedgerButton.Flyout>
          </lc:LedgerButton>
          <lc:LedgerButton x:Name="HistoryButton" Style="{StaticResource LedgerQuietIconButton}" PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited"
                  Command="{x:Bind ViewModel.ToggleHistoryCommand}" Visibility="{x:Bind Show(ViewModel.CanOpenHistory), Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.HistoryName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('History')}"
                  Background="{x:Bind HistoryBackground(ViewModel.IsHistoryOpen), Mode=OneWay}">
            <Path Data="M1,7 h2.4 v6 h-2.4 Z M5.8,3 h2.4 v10 h-2.4 Z M10.6,5 h2.4 v8 h-2.4 Z" Fill="{StaticResource LedgerInkBrush}" Width="14" Height="14" />
          </lc:LedgerButton>
          <lc:LedgerButton Style="{StaticResource LedgerQuietIconButton}" PointerEntered="OnIconPointerEntered" PointerExited="OnIconPointerExited"
                  Command="{x:Bind ViewModel.SignOutCommand}" Visibility="{x:Bind Show(ViewModel.CanSignOut), Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind ViewModel.SignOutName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Sign out')}">
            <Path Data="M5.5,2 H2.5 V12 H5.5 M9,4.5 L11.5,7 L9,9.5 M11.5,7 H5.5" Stroke="{StaticResource LedgerInk2Brush}" StrokeThickness="1.3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" />
          </lc:LedgerButton>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource LedgerPill}" Background="{x:Bind PillBackground(ViewModel.Visual.Tone), Mode=OneWay}"
                Visibility="{x:Bind Show(ViewModel.Visual.HasPill), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.Tip(ViewModel.Visual.PillTip), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse Width="6" Height="6" Fill="{x:Bind PillDot(ViewModel.Visual.Tone), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.Visual.Pill, Mode=OneWay}" Style="{StaticResource LedgerStrongText}" Foreground="{x:Bind PillText(ViewModel.Visual.Tone), Mode=OneWay}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="Enter saves · Esc cancels · the name is yours, the provider is unchanged" Style="{StaticResource LedgerCaptionText}" Margin="0,-4,0,0" TextWrapping="Wrap"
                 Visibility="{x:Bind Show(ViewModel.IsRenaming), Mode=OneWay}" />

      <!-- Bars: today row, period row, footer. -->
      <Grid x:Name="Bars" ColumnSpacing="10" Visibility="{x:Bind BarsVisibility(ViewModel.Visual.NoteLines.Count), Mode=OneWay}"
            XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="today" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                   Visibility="{x:Bind TodayLabelVisibility(ViewModel.Visual.HasStrip, ViewModel.Visual.HasTodayNote), Mode=OneWay}" />
        <Grid Grid.Column="1" ColumnSpacing="8" Visibility="{x:Bind Show(ViewModel.Visual.HasStrip), Mode=OneWay}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <lc:TodayStrip Cells="{x:Bind ViewModel.Visual.Cells, Mode=OneWay}" Opacity="{x:Bind ViewModel.Visual.Opacity, Mode=OneWay}" />
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Visual.OverLabel, Mode=OneWay}" Style="{StaticResource LedgerStrongText}" Foreground="{StaticResource LedgerCritTextBrush}"
                     LineHeight="14" VerticalAlignment="Center" Visibility="{x:Bind ShowCompactOver(ViewModel.Visual.HasOverLabel, ViewModel.IsCompact), Mode=OneWay}" />
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Visual.TodayNote, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" LineHeight="14" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource LedgerInk2Brush}"
                   TextTrimming="CharacterEllipsis" Visibility="{x:Bind Show(ViewModel.Visual.HasTodayNote), Mode=OneWay}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Visual.OverLabel, Mode=OneWay}" Style="{StaticResource LedgerStrongText}" Foreground="{StaticResource LedgerCritTextBrush}"
                   HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="{x:Bind ShowComfortableOver(ViewModel.Visual.HasOverLabel, ViewModel.IsCompact), Mode=OneWay}" />
        <Border Grid.Row="2" Grid.ColumnSpan="2" Height="{x:Bind StripGap(ViewModel.IsCompact, ViewModel.Visual.HasStrip), Mode=OneWay}" />
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.Visual.PeriodLabel, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center"
                   Visibility="{x:Bind Show(ViewModel.Visual.HasPeriodBar), Mode=OneWay}" />
        <ContentControl Grid.Row="3" Grid.Column="1" IsTabStop="True" UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="{StaticResource LedgerFocusBrush}"
                        HorizontalContentAlignment="Stretch" Margin="{x:Bind BarMargin(ViewModel.IsCompact), Mode=OneWay}"
                        Visibility="{x:Bind Show(ViewModel.Visual.HasPeriodBar), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind lc:LedgerViews.Tip(ViewModel.Visual.BarTip), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind lc:LedgerViews.Spoken(ViewModel.Visual.BarTip), Mode=OneWay}">
          <lc:PeriodBar Visual="{x:Bind ViewModel.Visual, Mode=OneWay}" Opacity="{x:Bind ViewModel.Visual.Opacity, Mode=OneWay}" />
        </ContentControl>
        <lc:LedgerFooterPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
          <ContentControl IsTabStop="True" UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="{StaticResource LedgerFocusBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          ToolTipService.ToolTip="{x:Bind lc:LedgerViews.Tip(ViewModel.Visual.FooterTip), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind FooterName(ViewModel.Visual.Footer, ViewModel.Visual.FooterTip), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.Visual.Footer, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" Foreground="{StaticResource LedgerInk2Brush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </ContentControl>
          <ContentControl Grid.Column="1" IsTabStop="True" UseSystemFocusVisuals="True" FocusVisualPrimaryBrush="{StaticResource LedgerFocusBrush}" VerticalAlignment="Center"
                          ToolTipService.ToolTip="{x:Bind lc:LedgerViews.Tip(ViewModel.Visual.ResetTip), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind lc:LedgerViews.Spoken(ViewModel.Visual.ResetTip), Mode=OneWay}">
            <TextBlock Text="{x:Bind ViewModel.Visual.ResetText, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" Foreground="{StaticResource LedgerInk3Brush}" TextWrapping="NoWrap" />
          </ContentControl>
          <lc:LedgerButton Grid.Column="2" Style="{StaticResource LedgerOutlineButton}" Content="{x:Bind ViewModel.Visual.ActionText, Mode=OneWay}" Command="{x:Bind ViewModel.ActionCommand}"
                  Visibility="{x:Bind Show(ViewModel.Visual.HasAction), Mode=OneWay}" />
        </lc:LedgerFooterPanel>
      </Grid>

      <!-- Note cards: fact lines without a bar or budget. -->
      <StackPanel Spacing="6" Visibility="{x:Bind NoteVisibility(ViewModel.Visual.NoteLines.Count), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Visual.NoteLines, Mode=OneWay}" IsTabStop="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ledger:NoteLine">
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Key}" Style="{StaticResource LedgerCaptionText}" />
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource LedgerBodyText}" Foreground="{StaticResource LedgerInk2Brush}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{x:Bind Right}" Style="{StaticResource LedgerCaptionText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <lc:LedgerButton Style="{StaticResource LedgerOutlineButton}" HorizontalAlignment="Right" Content="{x:Bind ViewModel.Visual.ActionText, Mode=OneWay}" Command="{x:Bind ViewModel.ActionCommand}"
                Visibility="{x:Bind Show(ViewModel.Visual.HasAction), Mode=OneWay}" />
      </StackPanel>
      <StackPanel x:Name="SectionHost" Spacing="{x:Bind InnerGap(ViewModel.IsCompact), Mode=OneWay}" Visibility="Collapsed" />
    </StackPanel>
  </lc:SquircleSurface>
</UserControl>
