<Window
    x:Class="AiUsage.Features.Ledger.Views.LedgerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ledger="using:AiUsage.Features.Ledger"
    xmlns:views="using:AiUsage.Features.Ledger.Views"
    xmlns:lc="using:AiUsage.Controls.Ledger"
    xmlns:tray="using:H.NotifyIcon">
  <Grid x:Name="Root" Background="{StaticResource LedgerBgPageBrush}" RequestedTheme="Dark" AutomationProperties.AutomationId="LedgerRoot"
        KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.Resources>
      <ResourceDictionary>
        <!-- Lightweight styling: text boxes keep the Ledger input surface in every state. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="#1A1918" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A1918" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A1918" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#55534E" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#9D998E" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#F0EEE6" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#F0EEE6" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F0EEE6" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F0EEE6" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#151413" />
        <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#3A3936" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#151413" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#3A3936" />
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <tray:TaskbarIcon x:Name="TrayIcon" NoLeftClickDelay="True" LeftClickCommand="{x:Bind ShowTrayCommand}" ToolTipText="AI Usage">
      <tray:TaskbarIcon.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem Text="Open AI Usage" Click="OnTrayOpen" />
          <MenuFlyoutItem Text="Refresh" Click="OnTrayRefresh" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Exit" Click="OnTrayExit" />
        </MenuFlyout>
      </tray:TaskbarIcon.ContextFlyout>
    </tray:TaskbarIcon>

    <!-- Title row (38): name, clock, day off and Work today, then Used/Left, +, Settings. The rest drags the window. -->
    <Grid x:Name="TitleRow" Padding="16,0,8,0" ColumnSpacing="10" BorderBrush="{StaticResource LedgerLineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="AI Usage" Style="{StaticResource LedgerTitleText}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" Style="{StaticResource LedgerClockText}" VerticalAlignment="Center" />
      <StackPanel x:Name="DayGroup" Grid.Column="2" Orientation="Horizontal" Spacing="10" Visibility="{x:Bind Show(ViewModel.IsDayOff), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.DayText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
        <Button x:Name="WorkTodayButton" Content="Work today" Command="{x:Bind ViewModel.ToggleWorkTodayCommand}"
                Style="{x:Bind WorkTodayStyle(ViewModel.WorkTodayOn), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind WorkTodayName(ViewModel.WorkTodayOn), Mode=OneWay}" />
      </StackPanel>
      <StackPanel x:Name="TitleControls" Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="DemoButton" Style="{StaticResource LedgerOutlineButton}" Content="Demo" Margin="0,0,6,0" Visibility="{x:Bind Show(ViewModel.IsDemo)}"
                AutomationProperties.Name="Demo scenarios" ToolTipService.ToolTip="Demo scenarios (demo build only)" Click="OnDemoClick" />
        <Border Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button x:Name="UsedButton" Content="Used" Style="{StaticResource LedgerSegmentButton}" Click="OnUsedClick"
                    Background="{x:Bind SegmentBackground(ViewModel.IsLeft, x:False), Mode=OneWay}" Foreground="{x:Bind SegmentForeground(ViewModel.IsLeft, x:False), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.ValueModeName, Mode=OneWay}" />
            <Button x:Name="LeftButton" Content="Left" Style="{StaticResource LedgerSegmentButton}" Click="OnLeftClick"
                    Background="{x:Bind SegmentBackground(ViewModel.IsLeft, x:True), Mode=OneWay}" Foreground="{x:Bind SegmentForeground(ViewModel.IsLeft, x:True), Mode=OneWay}"
                    AutomationProperties.Name="Show values: left" />
          </StackPanel>
        </Border>
        <Button x:Name="AddButton" Style="{StaticResource LedgerTitleIconButton}" AutomationProperties.Name="Add account" ToolTipService.ToolTip="Add account (Ctrl+N)">
          <Path Data="M8,3 V13 M3,8 H13" Stroke="{StaticResource LedgerInkBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
          <Button.Flyout>
            <Flyout x:Name="ProviderFlyout" Placement="BottomEdgeAlignedRight">
              <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                  <Setter Property="Padding" Value="4" />
                  <Setter Property="CornerRadius" Value="9" />
                  <Setter Property="MinWidth" Value="250" />
                </Style>
              </Flyout.FlyoutPresenterStyle>
              <StackPanel Width="242">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Providers}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="ledger:ProviderItem">
                      <Button Style="{StaticResource LedgerButtonBase}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="30" Padding="10,0,10,0"
                              IsEnabled="{x:Bind IsEnabled}" Tag="{x:Bind}" Click="OnProviderMenuClick" AutomationProperties.Name="{x:Bind ButtonName}">
                        <Grid>
                          <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerStrongText}" />
                          <TextBlock Text="{x:Bind MenuRight}" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Right" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource LedgerLineBrush}" Margin="0,4,0,4" />
                <CheckBox Content="Show signed-out accounts" IsChecked="{x:Bind ViewModel.ShowSignedOut, Mode=OneWay}" Click="OnShowSignedOutClick" Margin="10,0,0,0"
                          FontSize="12" Foreground="{StaticResource LedgerInkBrush}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SettingsButton" Style="{StaticResource LedgerTitleIconButton}" Command="{x:Bind ViewModel.ToggleSettingsCommand}" AutomationProperties.Name="Settings"
                ToolTipService.ToolTip="Settings (Ctrl+,)" Background="{x:Bind SettingsBackground(ViewModel.IsSettingsOpen), Mode=OneWay}">
          <Path Data="M8,1.8 V3.6 M8,12.4 V14.2 M1.8,8 H3.6 M12.4,8 H14.2 M3.6,3.6 L4.9,4.9 M11.1,11.1 L12.4,12.4 M3.6,12.4 L4.9,11.1 M11.1,4.9 L12.4,3.6 M10.2,8 A2.2,2.2 0 1 1 5.8,8 A2.2,2.2 0 1 1 10.2,8 Z"
                Stroke="{StaticResource LedgerInkBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Sign-in strip (34) under the title row. -->
    <Grid x:Name="SignInStrip" Grid.Row="1" Height="34" Padding="16,0,16,0" ColumnSpacing="8" Background="{StaticResource LedgerCardBrush}"
          BorderBrush="{StaticResource LedgerLineBrush}" BorderThickness="0,0,0,1" Visibility="{x:Bind Show(ViewModel.HasStrip), Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="8" Height="8" Fill="{x:Bind lc:LedgerTheme.ToneMark(ViewModel.StripTone), Mode=OneWay}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StripText, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{x:Bind StripSubText(ViewModel.StripSub, ViewModel.StripBusy), Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
      <Button Grid.Column="3" Content="{x:Bind ViewModel.StripAction, Mode=OneWay}" Command="{x:Bind ViewModel.StripActionCommand}"
              Style="{x:Bind StripActionStyle(ViewModel.StripActionIsPrimary), Mode=OneWay}" Visibility="{x:Bind ShowText(ViewModel.StripAction), Mode=OneWay}" />
      <ProgressBar Grid.ColumnSpan="4" IsIndeterminate="True" VerticalAlignment="Bottom" Margin="-16,0,-16,-1" Height="2" MinHeight="2"
                   Foreground="{StaticResource LedgerInk2Brush}" Background="{StaticResource LedgerRailBrush}"
                   Visibility="{x:Bind ShowProgress(ViewModel.StripBusy), Mode=OneWay}" />
    </Grid>

    <!-- Body: the card grid (or first run), the inline settings panel, and the undo bar overlay. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="CardScroller" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind Hide(ViewModel.IsFirstRun), Mode=OneWay}" IsTabStop="False">
        <lc:CardGridPanel x:Name="CardGrid" Gap="{x:Bind GridGap(ViewModel.IsCompact), Mode=OneWay}" Padding="{x:Bind BodyPadding(ViewModel.IsCompact, ViewModel.HasUndo), Mode=OneWay}"
                          Columns="{x:Bind GridColumns(ViewModel.IsSettingsOpen), Mode=OneWay}" XYFocusKeyboardNavigation="Enabled" />
      </ScrollViewer>

      <ScrollViewer Visibility="{x:Bind Show(ViewModel.IsFirstRun), Mode=OneWay}" IsTabStop="False">
        <StackPanel Width="460" Spacing="12" Margin="16,44,16,16" HorizontalAlignment="Center">
          <TextBlock Text="Add an account" Style="{StaticResource LedgerHeadingText}" />
          <TextBlock Text="AI Usage shows how much of each subscription limit is left today. Sign-in opens your browser; nothing is read before you sign in." Style="{StaticResource LedgerIntroText}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.Providers}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ledger:ProviderItem">
                <lc:SquircleSurface Radius="16" Fill="{StaticResource LedgerCardSurfaceBrush}" Stroke="{StaticResource LedgerLineCardBrush}" Padding="14,12,14,12" ColumnSpacing="10">
                  <lc:SquircleSurface.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </lc:SquircleSurface.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerCardNameText}" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource LedgerCaptionText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{x:Bind ButtonText}" IsEnabled="{x:Bind IsEnabled}" Tag="{x:Bind}" Click="OnProviderMenuClick"
                          Style="{StaticResource LedgerPrimaryButton}" AutomationProperties.Name="{x:Bind ButtonName}" />
                </lc:SquircleSurface>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="One account per provider in this version. Add more later with + in the title bar." Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <views:LedgerSettingsView x:Name="SettingsPanel" Grid.Column="1" Width="400" ViewModel="{x:Bind ViewModel.Settings}"
                                Visibility="{x:Bind Show(ViewModel.IsSettingsOpen), Mode=OneWay}" />

      <lc:SquircleSurface x:Name="UndoBar" Radius="9" Fill="{StaticResource LedgerTipBrush}" Stroke="{StaticResource LedgerLineWindowBrush}" Height="36"
                          Padding="14,0,8,0" ColumnSpacing="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                          Visibility="{x:Bind Show(ViewModel.HasUndo), Mode=OneWay}" GotFocus="OnUndoFocus" LostFocus="OnUndoBlur">
        <lc:SquircleSurface.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </lc:SquircleSurface.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.UndoText, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="Undo" Style="{StaticResource LedgerPrimaryButton}" Command="{x:Bind ViewModel.UndoCommand}"
                AutomationProperties.Name="{x:Bind UndoName(ViewModel.UndoText), Mode=OneWay}" />
        <TextBlock Grid.Column="2" Text="Ctrl+Z" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
      </lc:SquircleSurface>
    </Grid>
  </Grid>
</Window>
