<Window
    x:Class="AiUsage.Features.Ledger.Views.LedgerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ledger="using:AiUsage.Features.Ledger"
    xmlns:views="using:AiUsage.Features.Ledger.Views"
    xmlns:lc="using:AiUsage.Controls.Ledger"
    xmlns:tray="using:H.NotifyIcon">
  <Grid x:Name="Root" Background="{StaticResource LedgerBgPageBrush}" RequestedTheme="Dark" AutomationProperties.AutomationId="LedgerRoot"
        KeyboardAcceleratorPlacementMode="Hidden">
    <Grid.Resources>
      <ResourceDictionary>
        <!-- Lightweight styling: text boxes keep the Ledger input surface in every state. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource LedgerInputColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource LedgerInputColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource LedgerInputColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource LedgerLineCtlColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource LedgerInk3Color}" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource LedgerInkColor}" />
        <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource LedgerInkColor}" />
        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource LedgerInkColor}" />
        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource LedgerInkColor}" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="{StaticResource LedgerTipColor}" />
        <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="{StaticResource LedgerLineWindowColor}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource LedgerTipColor}" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource LedgerLineWindowColor}" />
      </ResourceDictionary>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <tray:TaskbarIcon x:Name="TrayIcon" NoLeftClickDelay="True" LeftClickCommand="{x:Bind ShowTrayCommand}" ToolTipText="AI Usage">
      <tray:TaskbarIcon.ContextFlyout>
        <MenuFlyout>
          <MenuFlyoutItem Text="Open AI Usage" Command="{x:Bind OpenWindowCommand}" />
          <MenuFlyoutItem Text="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitCommand}" />
        </MenuFlyout>
      </tray:TaskbarIcon.ContextFlyout>
    </tray:TaskbarIcon>

    <!-- Title row (38): name, refresh status, day off and Work today, then Used/Left, +, Settings. The rest drags the window. -->
    <Grid x:Name="TitleRow" Padding="16,0,8,0" ColumnSpacing="10" BorderBrush="{StaticResource LedgerLineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="AI Usage" Style="{StaticResource LedgerTitleText}" VerticalAlignment="Center" />
      <!-- Refresh doubles as the data status: quiet until hovered, red while an account is not refreshed in time. -->
      <lc:LedgerButton x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource LedgerTitleQuietIconButton}" Margin="-4,0,0,0" VerticalAlignment="Center"
              Command="{x:Bind ViewModel.RefreshCommand}" PointerEntered="OnRefreshPointerEntered" PointerExited="OnRefreshPointerExited"
              AutomationProperties.Name="{x:Bind RefreshName(ViewModel.RefreshTip), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.Tip(ViewModel.RefreshTip), Mode=OneWay}">
        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="15" Foreground="{x:Bind RefreshBrush(ViewModel.RefreshFailed), Mode=OneWay}" />
      </lc:LedgerButton>
      <StackPanel x:Name="DayGroup" Grid.Column="2" Orientation="Horizontal" Spacing="10" Visibility="{x:Bind Show(ViewModel.IsDayOff), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.DayText, Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
        <lc:LedgerButton x:Name="WorkTodayButton" Content="Work today" Command="{x:Bind ViewModel.ToggleWorkTodayCommand}"
                Style="{x:Bind WorkTodayStyle(ViewModel.WorkTodayOn), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind WorkTodayName(ViewModel.WorkTodayOn), Mode=OneWay}" />
      </StackPanel>
      <StackPanel x:Name="TitleControls" Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <lc:LedgerButton x:Name="DemoButton" Style="{StaticResource LedgerOutlineButton}" Content="Demo" Margin="0,0,6,0" Visibility="{x:Bind Show(ViewModel.IsDemo)}"
                AutomationProperties.Name="Demo scenarios" ToolTipService.ToolTip="{x:Bind lc:LedgerViews.TextTip('Demo scenarios (demo build only)')}" Click="OnDemoClick" />
        <Border Background="{StaticResource LedgerControlBrush}" CornerRadius="{StaticResource LedgerSegmentRadius}" Padding="2" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <lc:LedgerButton x:Name="UsedButton" Content="Used" Style="{StaticResource LedgerSegmentButton}" Click="OnUsedClick" IsEnabled="{x:Bind ViewModel.CanUseAccounts, Mode=OneWay}"
                    Background="{x:Bind SegmentBackground(ViewModel.IsLeft, x:False), Mode=OneWay}" Foreground="{x:Bind SegmentForeground(ViewModel.IsLeft, x:False), Mode=OneWay}"
                    AutomationProperties.Name="Show values: used" />
            <lc:LedgerButton x:Name="LeftButton" Content="Left" Style="{StaticResource LedgerSegmentButton}" Click="OnLeftClick" IsEnabled="{x:Bind ViewModel.CanUseAccounts, Mode=OneWay}"
                    Background="{x:Bind SegmentBackground(ViewModel.IsLeft, x:True), Mode=OneWay}" Foreground="{x:Bind SegmentForeground(ViewModel.IsLeft, x:True), Mode=OneWay}"
                    AutomationProperties.Name="Show values: left" />
          </StackPanel>
        </Border>
        <lc:LedgerButton x:Name="AddButton" Style="{StaticResource LedgerTitleIconButton}" AutomationProperties.Name="Add account" IsEnabled="{x:Bind ViewModel.CanUseAccounts, Mode=OneWay}">
          <Path Data="M8,3 V13 M3,8 H13" Stroke="{StaticResource LedgerInkBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
          <lc:LedgerButton.Flyout>
            <Flyout x:Name="ProviderFlyout" Placement="BottomEdgeAlignedRight">
              <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                  <Setter Property="RequestedTheme" Value="Dark" />
                  <Setter Property="HighContrastAdjustment" Value="None" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="CornerRadius" Value="0" />
                  <Setter Property="MinWidth" Value="250" />
                </Style>
              </Flyout.FlyoutPresenterStyle>
              <lc:SquircleSurface Radius="9" Fill="{StaticResource LedgerTipBrush}" Stroke="{StaticResource LedgerLineWindowBrush}" Padding="4">
                <StackPanel Width="242">
                  <ItemsControl ItemsSource="{x:Bind ViewModel.Providers}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="ledger:ProviderItem">
                        <lc:LedgerButton Style="{StaticResource LedgerButtonBase}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="30" Padding="10,0,10,0"
                                IsEnabled="{x:Bind IsEnabled}" Tag="{x:Bind}" Click="OnProviderMenuClick" AutomationProperties.Name="{x:Bind ButtonName}">
                          <Grid>
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerStrongText}" />
                            <TextBlock Text="{x:Bind MenuRight}" Style="{StaticResource LedgerCaptionText}" HorizontalAlignment="Right" />
                          </Grid>
                        </lc:LedgerButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Height="1" Background="{StaticResource LedgerLineBrush}" Margin="0,4,0,4" />
                  <lc:LedgerCheckBox Style="{StaticResource LedgerCheckBox}" Content="Show signed-out accounts" IsChecked="{x:Bind ViewModel.ShowSignedOut, Mode=OneWay}" Click="OnShowSignedOutClick" Margin="10,0,0,0"
                            FontSize="12" Foreground="{StaticResource LedgerInkBrush}" />
                </StackPanel>
              </lc:SquircleSurface>
            </Flyout>
          </lc:LedgerButton.Flyout>
        </lc:LedgerButton>
        <lc:LedgerButton x:Name="SettingsButton" Style="{StaticResource LedgerTitleIconButton}" Command="{x:Bind ViewModel.ToggleSettingsCommand}" AutomationProperties.Name="Settings"
                Background="{x:Bind SettingsBackground(ViewModel.IsSettingsOpen), Mode=OneWay}">
          <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource LedgerInkBrush}" />
        </lc:LedgerButton>
      </StackPanel>
    </Grid>

    <!-- One transient sign-in line: status dot, provider, then a device code, a short next step or a pasted-code box. -->
    <Grid x:Name="SignInStrip" Grid.Row="1" Height="52" Padding="16,0,12,0" ColumnSpacing="8" Background="{StaticResource LedgerCardBrush}"
          BorderBrush="{StaticResource LedgerLineBrush}" BorderThickness="0,0,0,1" Visibility="{x:Bind Show(ViewModel.HasStrip), Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- While waiting on the user an amber wave spreads from the dot; the wave is a render transform, so it never moves the row. -->
      <Grid Width="7" Height="7" Margin="0,0,2,0" VerticalAlignment="Center">
        <Ellipse x:Name="StripWave" Fill="{x:Bind StripDot(ViewModel.StripTone, ViewModel.StripBusy), Mode=OneWay}" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><ScaleTransform x:Name="StripWaveScale" /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Fill="{x:Bind StripDot(ViewModel.StripTone, ViewModel.StripBusy), Mode=OneWay}" />
      </Grid>
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StripTitle, Mode=OneWay}" Style="{StaticResource LedgerStrongText}" FontSize="13" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind ShowText(ViewModel.StripCode), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.StripCode, Mode=OneWay}" FontFamily="{StaticResource LedgerMonoFont}" FontSize="20" CharacterSpacing="60"
                   Foreground="{StaticResource LedgerInkBrush}" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
        <lc:LedgerButton x:Name="CopyCodeButton" Style="{StaticResource LedgerIconButton}" Click="OnCopyCodeClick" VerticalAlignment="Center"
                AutomationProperties.Name="Copy code">
          <FontIcon x:Name="CopyCodeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="14" Foreground="{StaticResource LedgerInk2Brush}" />
        </lc:LedgerButton>
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{x:Bind StripDetail(ViewModel.StripText, ViewModel.StripBusy, ViewModel.CodeError), Mode=OneWay}" Style="{StaticResource LedgerCaptionText}" FontSize="13"
                 Foreground="{x:Bind StripDetailBrush(ViewModel.CodeError), Mode=OneWay}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{x:Bind Show(ViewModel.StripAcceptsCode), Mode=OneWay}">
        <TextBox Width="200" Text="{x:Bind ViewModel.SignInCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Code" AutomationProperties.Name="Sign-in code" />
        <lc:LedgerButton Content="Add" Style="{StaticResource LedgerPrimaryButton}" Command="{x:Bind ViewModel.SubmitSignInCodeCommand}" AutomationProperties.Name="Submit code" />
      </StackPanel>
      <lc:LedgerButton Grid.Column="5" Content="{x:Bind ViewModel.StripAction, Mode=OneWay}" Command="{x:Bind ViewModel.StripActionCommand}" VerticalAlignment="Center"
              Style="{x:Bind StripActionStyle(ViewModel.StripActionIsPrimary), Mode=OneWay}" Visibility="{x:Bind ShowText(ViewModel.StripAction), Mode=OneWay}" />
      <lc:LedgerButton Grid.Column="6" Style="{StaticResource LedgerIconButton}" Command="{x:Bind ViewModel.DismissStripCommand}" Visibility="{x:Bind Hide(ViewModel.StripBusy), Mode=OneWay}"
              VerticalAlignment="Center" AutomationProperties.Name="Close">
        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource LedgerInk2Brush}" />
      </lc:LedgerButton>
    </Grid>

    <!-- Body: the card grid (or first run), the settings sheet over them, and the undo bar overlay. -->
    <Grid x:Name="Body" Grid.Row="2">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Orientation="Vertical" Spacing="6" Margin="16,10" Visibility="{x:Bind Show(ViewModel.NeedsRecovery), Mode=OneWay}">
        <TextBlock Text="{x:Bind ViewModel.RecoveryText, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" TextWrapping="Wrap" />
        <lc:LedgerButton Style="{StaticResource LedgerOutlineButton}" Content="Recovery and diagnostics" Command="{x:Bind ViewModel.OpenSettingsCommand}" HorizontalAlignment="Left" />
      </StackPanel>
      <TextBlock Text="Opening local data…" Margin="16,10" Style="{StaticResource LedgerBodyText}" Visibility="{x:Bind Show(ViewModel.IsStarting), Mode=OneWay}" />
      <ScrollViewer x:Name="CardScroller" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind Hide(ViewModel.IsFirstRun), Mode=OneWay}" IsTabStop="False">
        <Grid>
          <!-- S1 (D-193): one column of full-width cards; inline history follows its card. -->
          <StackPanel x:Name="CardGrid" Spacing="{x:Bind GridGap(ViewModel.IsCompact), Mode=OneWay}" Padding="{x:Bind BodyPadding(ViewModel.IsCompact, ViewModel.HasUndo), Mode=OneWay}"
                      XYFocusKeyboardNavigation="Enabled" />
          <!-- D-205: while a card is dragged by its grip, a line marks the gap it would drop into. -->
          <Canvas x:Name="DragLayer" IsHitTestVisible="False">
            <Rectangle x:Name="InsertionLine" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource LedgerFocusBrush}" Visibility="Collapsed" />
          </Canvas>
        </Grid>
      </ScrollViewer>

      <ScrollViewer x:Name="FirstRunScroller" Grid.Row="1" Visibility="{x:Bind Show(ViewModel.IsFirstRun), Mode=OneWay}" IsTabStop="False">
        <StackPanel MaxWidth="460" Spacing="12" Margin="16,44,16,16" HorizontalAlignment="Stretch">
          <TextBlock Text="Add an account" Style="{StaticResource LedgerHeadingText}" />
          <TextBlock Text="AI Usage shows how much of each subscription limit is left today. Sign-in opens your browser; nothing is read before you sign in." Style="{StaticResource LedgerIntroText}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.Providers}" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="ledger:ProviderItem">
                <lc:SquircleSurface Radius="16" Fill="{StaticResource LedgerCardSurfaceBrush}" Stroke="{StaticResource LedgerLineCardBrush}" Padding="14,12,14,12" ColumnSpacing="10">
                  <lc:SquircleSurface.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </lc:SquircleSurface.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource LedgerCardNameText}" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource LedgerCaptionText}" />
                  </StackPanel>
                  <lc:LedgerButton Grid.Column="1" Content="{x:Bind ButtonText}" IsEnabled="{x:Bind IsEnabled}" Tag="{x:Bind}" Click="OnProviderMenuClick"
                          Style="{StaticResource LedgerPrimaryButton}" AutomationProperties.Name="{x:Bind ButtonName}" />
                </lc:SquircleSurface>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Add more accounts with + in the title bar. Each account keeps its own limits and history." Style="{StaticResource LedgerCaptionText}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>

      <!-- S5 (D-197): the sheet covers the whole body and leaves the cards in place. It keeps the body's height while the
           host's height slides open and shut, so it rolls down from under the title row and back up. -->
      <Grid x:Name="SettingsHost" Grid.RowSpan="2" Height="0" VerticalAlignment="Top" Background="{StaticResource LedgerBgPageBrush}" Visibility="Collapsed">
        <views:LedgerSettingsView x:Name="SettingsPanel" ViewModel="{x:Bind ViewModel.Settings}" />
      </Grid>

      <lc:SquircleSurface x:Name="UndoBar" Grid.Row="1" Radius="9" Fill="{StaticResource LedgerTipBrush}" Stroke="{StaticResource LedgerLineWindowBrush}" Height="36"
                          Padding="14,0,8,0" ColumnSpacing="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                          Visibility="{x:Bind Show(ViewModel.HasUndo), Mode=OneWay}" GotFocus="OnUndoFocus" LostFocus="OnUndoBlur">
        <lc:SquircleSurface.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </lc:SquircleSurface.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.UndoText, Mode=OneWay}" Style="{StaticResource LedgerBodyText}" VerticalAlignment="Center" />
        <lc:LedgerButton Grid.Column="1" Content="Undo" Style="{StaticResource LedgerPrimaryButton}" Command="{x:Bind ViewModel.UndoCommand}"
                AutomationProperties.Name="{x:Bind UndoName(ViewModel.UndoText), Mode=OneWay}" />
        <TextBlock Grid.Column="2" Text="Ctrl+Z" Style="{StaticResource LedgerCaptionText}" VerticalAlignment="Center" />
      </lc:SquircleSurface>
    </Grid>
  </Grid>
</Window>
