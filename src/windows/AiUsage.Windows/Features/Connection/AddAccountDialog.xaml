<ContentDialog
    x:Class="AiUsage.Features.Connection.AddAccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:connection="using:AiUsage.Features.Connection"
    xmlns:cli="using:AiUsage.Features.CliImport"
    AutomationProperties.AutomationId="AddAccountDialog"
    AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
    Background="{ThemeResource CardBrush}"
    BorderBrush="{ThemeResource Stroke2Brush}"
    BorderThickness="1"
    CornerRadius="8">
  <Grid Width="520" MaxWidth="520">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="20,16,12,0">
      <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource Heading18Text}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
      <Button x:Uid="AddAccount_Close" AutomationProperties.AutomationId="AddAccountClose" Style="{StaticResource GhostIconButton}" Width="28" Height="28" HorizontalAlignment="Right"
              Command="{x:Bind ViewModel.CloseCommand}">
        <TextBlock Text="✕" FontSize="13" />
      </Button>
    </Grid>
    <Border Grid.Row="1" Margin="0,6,0,0" Padding="20,0" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="18" XYFocusKeyboardNavigation="Enabled" AutomationProperties.AutomationId="AddAccountTabs">
        <RadioButton x:Name="SignInTab" x:Uid="AddAccount_TabSignIn" AutomationProperties.AutomationId="AddAccountTabSignIn" GroupName="AddAccountTabs" Style="{StaticResource TabRadio}" FontSize="13"
                     IsChecked="{x:Bind controls:Bind.IsAddAccountTab(ViewModel.Tab, 0), Mode=OneWay}" Checked="OnSignInChecked" />
        <RadioButton x:Name="CliTab" x:Uid="AddAccount_TabCli" AutomationProperties.AutomationId="AddAccountTabCli" GroupName="AddAccountTabs" Style="{StaticResource TabRadio}" FontSize="13"
                     IsChecked="{x:Bind controls:Bind.IsAddAccountTab(ViewModel.Tab, 1), Mode=OneWay}" Checked="OnCliChecked" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
      <Grid Padding="20,18,20,20">
        <!-- S03 Sign in -->
        <StackPanel Spacing="14" Visibility="{x:Bind controls:Bind.VisibleForTab(ViewModel.Tab, 0), Mode=OneWay}">
          <!-- Pick provider -->
          <StackPanel Spacing="12" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsPick), Mode=OneWay}" controls:Motion.Entrance="True">
            <TextBlock x:Uid="Connect_PickHelp" Style="{StaticResource CaptionText}" />
            <TextBlock Text="{x:Bind ViewModel.Note, Mode=OneWay}" Style="{StaticResource CaptionText}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasNote), Mode=OneWay}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ProviderOptions}" AutomationProperties.AutomationId="ProviderOptions">
              <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="228" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" MaximumRowsOrColumns="2" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="connection:ProviderOptionViewModel">
                  <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" CornerRadius="7"
                          Click="OnProviderClick" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind Availability}">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <controls:ProviderTile ProviderId="{x:Bind ProviderId}" TileSize="28" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource Body13StrongText}" />
                        <TextBlock Text="{x:Bind Availability}" Style="{StaticResource Caption11Text}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>

          <!-- Method -->
          <StackPanel Spacing="14" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsMethod), Mode=OneWay}" controls:Motion.Entrance="True">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <controls:ProviderTile ProviderId="{x:Bind ViewModel.Provider.ProviderId, Mode=OneWay}" TileSize="28" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Provider.Name, Mode=OneWay}" Style="{StaticResource Body13StrongText}" />
                <TextBlock x:Uid="Connect_PlannedNote" Style="{StaticResource Caption11Text}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.Provider.IsPlanned), Mode=OneWay}" />
              </StackPanel>
              <Button Grid.Column="2" x:Uid="Connect_ChangeProvider" AutomationProperties.AutomationId="ChangeProvider" Style="{StaticResource SmallLinkButton}" Command="{x:Bind ViewModel.ChangeProviderCommand}"
                      Visibility="{x:Bind ReconnectCollapsed(ViewModel.ReconnectAccountId), Mode=OneWay}" />
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock x:Uid="Connect_MethodLabel" Style="{StaticResource CaptionText}" />
              <Border Style="{StaticResource SegmentHost}">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Methods}" AutomationProperties.AutomationId="ConnectMethods" XYFocusKeyboardNavigation="Enabled">
                  <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="connection:MethodOptionViewModel">
                      <RadioButton Style="{StaticResource SegmentRadio}" Content="{x:Bind Label}" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnMethodClick" Tag="{x:Bind}" Padding="14,6,14,7" />
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </Border>
            </StackPanel>
            <Border Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasNote), Mode=OneWay}" CornerRadius="6" BorderThickness="1" Padding="12,8"
                    controls:Tokens.Background="{x:Bind controls:Bind.NoteBackground(ViewModel.NoteSeverity), Mode=OneWay}" controls:Tokens.Border="{x:Bind controls:Bind.NoteBorder(ViewModel.NoteSeverity), Mode=OneWay}" controls:Motion.Entrance="True">
              <TextBlock Text="{x:Bind ViewModel.Note, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextBrush}" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="ConnectCancel" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.CloseCommand}" />
              <Button AutomationProperties.AutomationId="ConnectStart" Style="{StaticResource PrimaryButton}" MinWidth="120" Content="{x:Bind ViewModel.StartLabel, Mode=OneWay}" Command="{x:Bind ViewModel.StartCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Connecting -->
          <StackPanel Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsConnecting), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,12">
              <controls:BusyRing Size="16" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsConnecting), Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock Text="{x:Bind ViewModel.ConnectingText, Mode=OneWay}" Style="{StaticResource Body13Text}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="ConnectingCancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.CancelCommand}" />
          </StackPanel>

          <!-- Waiting -->
          <StackPanel Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsWaiting), Mode=OneWay}" controls:Motion.Entrance="True">
            <StackPanel Spacing="6" Padding="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <controls:BusyRing Size="16" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsWaiting), Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock x:Uid="Connect_WaitingTitleText" Style="{StaticResource Body13StrongText}" VerticalAlignment="Center" AutomationProperties.AutomationId="ConnectWaiting" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.WaitingText, Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="26,0,0,0" LineHeight="18" />
              <Button x:Uid="Connect_EnterCode" AutomationProperties.AutomationId="EnterCodeInstead" Style="{StaticResource SmallLinkButton}" Margin="24,0,0,0" HorizontalAlignment="Left"
                      Visibility="{x:Bind controls:Bind.Visible(ViewModel.SupportsManualCode), Mode=OneWay}" Command="{x:Bind ViewModel.EnterCodeInsteadCommand}" />
            </StackPanel>
            <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="WaitingCancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{x:Bind ViewModel.CancelCommand}" />
            <Border BorderBrush="{ThemeResource Stroke2Brush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasSimulator)}">
              <StackPanel Spacing="6">
                <Border Style="{StaticResource OutlineBadge}" Background="{ThemeResource Card2Brush}" BorderBrush="{ThemeResource StrokeBrush}" HorizontalAlignment="Left">
                  <TextBlock x:Uid="Sim_Badge" Style="{StaticResource CaptionText}" FontWeight="SemiBold" />
                </Border>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Simulators}" AutomationProperties.AutomationId="ConnectSimulators">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="connection:SimulatorOption">
                      <Button Style="{StaticResource SmallSecondaryButton}" Content="{x:Bind Label}" Click="OnSimulatorClick" Tag="{x:Bind}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Code entry -->
          <StackPanel Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsCode), Mode=OneWay}" controls:Motion.Entrance="True">
            <TextBlock Text="{x:Bind ViewModel.CodePrompt, Mode=OneWay}" Style="{StaticResource CaptionText}" />
            <TextBox x:Name="CodeBox" AutomationProperties.AutomationId="ManualCode" AutomationProperties.Name="{x:Bind ViewModel.CodePrompt, Mode=OneWay}"
                     Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="16" CharacterSpacing="80"
                     IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Background="{ThemeResource AppBgBrush}" Padding="10,8" CornerRadius="5" KeyDown="OnCodeKeyDown"
                     controls:Tokens.Border="{x:Bind CodeBorder(ViewModel.HasCodeError), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.CodeError, Mode=OneWay}" Style="{StaticResource ErrorText}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasCodeError), Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock x:Uid="Connect_CodeNeverStored" Style="{StaticResource Caption11Text}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="CodeCancel" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.CancelCommand}" />
              <Button x:Uid="Connect_SubmitCode" AutomationProperties.AutomationId="SubmitCode" Style="{StaticResource PrimaryButton}" MinWidth="120" Command="{x:Bind ViewModel.SubmitCodeCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Verifying -->
          <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,12" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsVerifying), Mode=OneWay}">
            <controls:BusyRing Size="16" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsVerifying), Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock x:Uid="Connect_Verifying" Style="{StaticResource Body13Text}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Result -->
          <StackPanel Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsResult), Mode=OneWay}" controls:Motion.Entrance="True">
            <StackPanel Spacing="6" Padding="0,8,0,0" AutomationProperties.AutomationId="ConnectResult">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="✓" FontWeight="Bold" controls:Tokens.Foreground="{x:Bind ResultGlyphBrush(ViewModel.ResultPositive), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Style="{StaticResource Body13StrongText}" />
              </StackPanel>
              <TextBlock Text="{x:Bind ViewModel.ResultBody, Mode=OneWay}" Style="{StaticResource CaptionText}" Margin="20,0,0,0" LineHeight="18" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Uid="Dialog_CloseButton" AutomationProperties.AutomationId="ResultClose" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.CloseCommand}" />
              <Button x:Uid="Connect_OpenAccount" AutomationProperties.AutomationId="ResultOpenAccount" Style="{StaticResource PrimaryButton}" Command="{x:Bind ViewModel.OpenResultCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- S08 Import from CLI -->
        <cli:CliImportView ViewModel="{x:Bind ViewModel.Cli}" CloseCommand="{x:Bind ViewModel.CloseCommand}" Visibility="{x:Bind controls:Bind.VisibleForTab(ViewModel.Tab, 1), Mode=OneWay}" />
      </Grid>
    </ScrollViewer>
  </Grid>
</ContentDialog>
