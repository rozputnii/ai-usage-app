<Page
    x:Class="AiUsage.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:appearance="using:AiUsage.Features.Settings.Appearance"
    xmlns:monitoring="using:AiUsage.Features.Settings.Monitoring"
    xmlns:data="using:AiUsage.Features.Settings.DataPrivacy"
    xmlns:updates="using:AiUsage.Features.Settings.Updates"
    xmlns:platform="using:AiUsage.Platform"
    NavigationCacheMode="Required"
    Background="Transparent"
    AutomationProperties.AccessibilityView="Control"
    AutomationProperties.AutomationId="SettingsPage">
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="{x:Bind Gutter(platform:AppLayout.Current.IsCompact), Mode=OneWay}" Spacing="14" controls:Motion.Entrance="True">
      <TextBlock x:Uid="Settings_Title" Style="{StaticResource Title26Text}" Padding="0,20,0,0" AutomationProperties.HeadingLevel="Level1" />
      <Border BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,0,0,1">
        <controls:WrapPanel HorizontalSpacing="18" AutomationProperties.AutomationId="SettingsTabs" x:Uid="Settings_TabsGroup" XYFocusKeyboardNavigation="Enabled" controls:ArrowNavigation.Enabled="True" TabFocusNavigation="Once">
          <RadioButton x:Uid="Settings_TabAppearanceButton" AutomationProperties.AutomationId="TabAppearance" GroupName="SettingsTabs" Style="{StaticResource TabRadio}" Tag="0" Click="OnTabClick"
                       IsChecked="{x:Bind ViewModel.IsAppearance, Mode=OneWay}" />
          <RadioButton x:Uid="Settings_TabMonitoringButton" AutomationProperties.AutomationId="TabMonitoring" GroupName="SettingsTabs" Style="{StaticResource TabRadio}" Tag="1" Click="OnTabClick"
                       IsChecked="{x:Bind ViewModel.IsMonitoring, Mode=OneWay}" />
          <RadioButton x:Uid="Settings_TabDataButton" AutomationProperties.AutomationId="TabDataPrivacy" GroupName="SettingsTabs" Style="{StaticResource TabRadio}" Tag="2" Click="OnTabClick"
                       IsChecked="{x:Bind ViewModel.IsDataPrivacy, Mode=OneWay}" />
          <RadioButton x:Uid="Settings_TabUpdatesButton" AutomationProperties.AutomationId="TabUpdates" GroupName="SettingsTabs" Style="{StaticResource TabRadio}" Tag="3" Click="OnTabClick"
                       IsChecked="{x:Bind ViewModel.IsUpdates, Mode=OneWay}" />
        </controls:WrapPanel>
      </Border>
      <appearance:AppearanceSettingsView ViewModel="{x:Bind ViewModel.Appearance, Mode=OneWay}" MaxWidth="760" HorizontalAlignment="Left" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsAppearance), Mode=OneWay}" controls:Motion.Entrance="True" />
      <monitoring:MonitoringSettingsView ViewModel="{x:Bind ViewModel.Monitoring, Mode=OneWay}" MaxWidth="760" HorizontalAlignment="Left" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsMonitoring), Mode=OneWay}" controls:Motion.Entrance="True" />
      <data:DataPrivacyView ViewModel="{x:Bind ViewModel.DataPrivacy, Mode=OneWay}" MaxWidth="760" HorizontalAlignment="Left" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsDataPrivacy), Mode=OneWay}" controls:Motion.Entrance="True" />
      <updates:UpdatesView ViewModel="{x:Bind ViewModel.Updates, Mode=OneWay}" MaxWidth="760" HorizontalAlignment="Left" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsUpdates), Mode=OneWay}" controls:Motion.Entrance="True" />
    </StackPanel>
  </ScrollViewer>
</Page>
