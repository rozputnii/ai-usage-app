<UserControl
    x:Class="AiUsage.Features.Settings.Appearance.AppearanceSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    xmlns:appearance="using:AiUsage.Features.Settings.Appearance"
    IsTabStop="False"
    AutomationProperties.AutomationId="AppearanceSettings">
  <UserControl.Resources>
    <Style x:Key="ThemeCardRadio" TargetType="RadioButton">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
      <Setter Property="FocusVisualMargin" Value="-3" />
      <Setter Property="FocusVisualPrimaryThickness" Value="2" />
      <Setter Property="FocusVisualSecondaryThickness" Value="0" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource FocusBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                      <Setter Target="Card.BorderBrush" Value="{ThemeResource Text2Brush}" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Pressed" />
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualState x:Name="Checked">
                    <VisualState.Setters>
                      <Setter Target="Card.BorderBrush" Value="{ThemeResource AccentBrush}" />
                      <Setter Target="Ring.Opacity" Value="1" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Unchecked" />
                  <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Ring" CornerRadius="8" BorderBrush="{ThemeResource AccentBrush}" BorderThickness="2" Margin="-1" Opacity="0" />
              <Border x:Name="Card" CornerRadius="7" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource Stroke2Brush}" BorderThickness="1" Padding="12">
                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <StackPanel Spacing="22" Padding="0,0,0,24">
    <!-- App theme -->
    <StackPanel Spacing="10">
      <TextBlock x:Uid="Appearance_ThemeHeading" Style="{StaticResource Section16Text}" AutomationProperties.HeadingLevel="Level2" />
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}" AutomationProperties.AutomationId="ThemeOptions" x:Uid="Appearance_ThemeGroup" XYFocusKeyboardNavigation="Enabled">
        <ItemsRepeater.Layout>
          <UniformGridLayout MinItemWidth="180" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" MaximumRowsOrColumns="3" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="appearance:ThemeOptionViewModel">
            <RadioButton Style="{StaticResource ThemeCardRadio}" GroupName="AppTheme" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnThemeClick" Tag="{x:Bind}"
                         AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}" AutomationProperties.AutomationId="{x:Bind controls:Bind.ThemeId(Preference)}">
              <StackPanel Spacing="10">
                <Border Height="56" CornerRadius="5" BorderThickness="1" BorderBrush="{ThemeResource StrokeBrush}" Background="{x:Bind controls:Bind.ThemePreview(PreviewIsDark, 0), Mode=OneWay}" AutomationProperties.AccessibilityView="Raw">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="14" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{x:Bind controls:Bind.ThemePreview(PreviewIsDark, 1), Mode=OneWay}" CornerRadius="4,4,0,0" />
                    <StackPanel Grid.Row="1" Padding="8" Spacing="5">
                      <Border Height="6" Width="60" HorizontalAlignment="Left" CornerRadius="2" Background="{x:Bind controls:Bind.ThemePreview(PreviewIsDark, 2), Mode=OneWay}" />
                      <Grid Height="3">
                        <Border CornerRadius="2" Background="{x:Bind controls:Bind.ThemePreview(PreviewIsDark, 3), Mode=OneWay}" />
                        <Border CornerRadius="2" Background="{x:Bind controls:Bind.ThemePreview(PreviewIsDark, 2), Mode=OneWay}" HorizontalAlignment="Left" Width="70" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Grid Width="14" Height="14" VerticalAlignment="Center">
                    <Ellipse Stroke="{ThemeResource Stroke2Brush}" StrokeThickness="1.5" />
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentBrush}" Opacity="{x:Bind controls:Bind.SelectedOpacity(IsSelected), Mode=OneWay}" />
                  </Grid>
                  <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource Body13StrongText}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionText}" LineHeight="17" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
      <TextBlock Text="{x:Bind ViewModel.ThemeNote, Mode=OneWay}" Style="{StaticResource CaptionText}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ThemeNote" />
    </StackPanel>

    <!-- Layout -->
    <StackPanel>
      <TextBlock x:Uid="Appearance_LayoutHeading" Style="{StaticResource Section16Text}" Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource HairlineRow}" Padding="0,12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Appearance_Density" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Appearance_DensityHelp" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <controls:SegmentedControl Grid.Column="1" AutomationProperties.AutomationId="DensitySelector" x:Uid="Appearance_DensityGroup" Items="{x:Bind ViewModel.DensityLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.DensityIndex, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Style="{StaticResource HairlineRow}" Padding="0,12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Appearance_AlwaysOnTop" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Appearance_AlwaysOnTopHelp" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" x:Uid="Appearance_AlwaysOnTopSwitch" AutomationProperties.AutomationId="AlwaysOnTopSwitch" IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Style="{StaticResource HairlineRow}" Padding="0,12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Appearance_ShowDisconnected" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Appearance_ShowDisconnectedHelp" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" x:Uid="Appearance_ShowDisconnectedSwitch" AutomationProperties.AutomationId="ShowDisconnectedSwitch" IsOn="{x:Bind ViewModel.ShowDisconnected, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Order and visibility -->
    <StackPanel>
      <TextBlock x:Uid="Appearance_OrderHeading" Style="{StaticResource Section16Text}" AutomationProperties.HeadingLevel="Level2" />
      <TextBlock x:Uid="Appearance_OrderHelp" Style="{StaticResource CaptionText}" Margin="0,2,0,8" />
      <ItemsRepeater ItemsSource="{x:Bind ViewModel.OrderItems, Mode=OneWay}" AutomationProperties.AutomationId="OrderList">
        <ItemsRepeater.ItemTemplate>
          <DataTemplate x:DataType="appearance:OrderItemViewModel">
            <Border Style="{StaticResource HairlineRow}" Padding="0,8" IsTabStop="False">
              <Grid ColumnSpacing="10" KeyDown="OnOrderKeyDown" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" MinWidth="140">
                  <Run Text="{x:Bind Label, Mode=OneWay}" /><Run Text=" · " Foreground="{ThemeResource Text2Brush}" FontSize="12" /><Run Text="{x:Bind ProviderName, Mode=OneWay}" Foreground="{ThemeResource Text2Brush}" FontSize="12" />
                </TextBlock>
                <TextBlock Grid.Column="1" x:Uid="Order_HiddenTag" Style="{StaticResource Caption11Text}" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(IsHidden), Mode=OneWay}" />
                <TextBlock Grid.Column="2" x:Uid="Order_MutedTag" Style="{StaticResource Caption11Text}" VerticalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(IsMuted), Mode=OneWay}" />
                <Button Grid.Column="3" Style="{StaticResource SmallSecondaryButton}" MinWidth="52" Content="{x:Bind HideLabel, Mode=OneWay}" Command="{x:Bind ToggleHiddenCommand}" />
                <Button Grid.Column="4" Style="{StaticResource SmallSecondaryButton}" MinWidth="60" Content="{x:Bind MuteLabel, Mode=OneWay}" controls:CapabilityGate.Key="SetMute" Command="{x:Bind ToggleMutedCommand}" />
                <Button Grid.Column="5" Style="{StaticResource SmallSecondaryButton}" Width="26" Padding="0" Foreground="{ThemeResource Text2Brush}" AutomationProperties.Name="{x:Bind MoveUpName, Mode=OneWay}" Command="{x:Bind MoveUpCommand}">
                  <TextBlock Text="▲" FontSize="10" />
                </Button>
                <Button Grid.Column="6" Style="{StaticResource SmallSecondaryButton}" Width="26" Padding="0" Foreground="{ThemeResource Text2Brush}" AutomationProperties.Name="{x:Bind MoveDownName, Mode=OneWay}" Command="{x:Bind MoveDownCommand}">
                  <TextBlock Text="▼" FontSize="10" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsRepeater.ItemTemplate>
      </ItemsRepeater>
    </StackPanel>
  </StackPanel>
</UserControl>
