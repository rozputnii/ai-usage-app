<UserControl
    x:Class="AiUsage.Features.Settings.DataPrivacy.DataPrivacyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AiUsage.Controls"
    IsTabStop="False"
    AutomationProperties.AutomationId="DataPrivacySettings">
  <StackPanel Spacing="22" Padding="0,0,0,24">
    <!-- History collection -->
    <StackPanel>
      <TextBlock x:Uid="Data_HistoryHeading" Style="{StaticResource Section16Text}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource HairlineRow}" Padding="0,10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Data_RecordHistory" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Data_RecordHistoryHelp" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" x:Uid="Data_RecordHistorySwitch" controls:CapabilityGate.Key="HistoryEnabled" AutomationProperties.AutomationId="HistoryEnabledSwitch" IsOn="{x:Bind ViewModel.HistoryEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Border Style="{StaticResource HairlineRow}" Padding="0,10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Data_Retention" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Data_RetentionHelp" Style="{StaticResource CaptionText}" />
          </StackPanel>
          <ComboBox Grid.Column="1" x:Uid="Data_RetentionBox" controls:CapabilityGate.Key="Retention" AutomationProperties.AutomationId="RetentionSelector" Style="{StaticResource AppComboBox}" MinWidth="160" VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.RetentionLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.RetentionIndex, Mode=TwoWay}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- Export -->
    <StackPanel>
      <TextBlock x:Uid="Data_ExportHeading" Style="{StaticResource Section16Text}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource HairlineRow}" Padding="0,10">
        <StackPanel Spacing="10">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Data_ExportHelp" Style="{StaticResource CaptionText}" LineHeight="17" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Uid="Data_PrepareExport" AutomationProperties.AutomationId="PrepareExport" Style="{StaticResource SecondaryButton}" MinWidth="150" controls:CapabilityGate.Key="PreviewExport" Command="{x:Bind ViewModel.PrepareExportCommand, Mode=OneWay}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsExportIdle), Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" MinWidth="220" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsExportPreparing), Mode=OneWay}">
              <ProgressBar Width="100" Minimum="0" Maximum="1" Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}" VerticalAlignment="Center" x:Uid="Data_ExportProgress" AutomationProperties.AutomationId="ExportProgress" />
              <TextBlock x:Uid="Data_Preparing" Style="{StaticResource CaptionText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
              <Button x:Uid="Dialog_CancelButton" AutomationProperties.AutomationId="CancelExport" Style="{StaticResource SmallLinkButton}" Command="{x:Bind ViewModel.CancelExportCommand, Mode=OneWay}" />
            </StackPanel>
          </Grid>
          <Border BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsExportReady), Mode=OneWay}" controls:Motion.Entrance="True"
                  AutomationProperties.AutomationId="ExportPreview">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="✓" FontWeight="Bold" Foreground="{ThemeResource OkBrush}" />
                <TextBlock Text="{x:Bind ViewModel.ExportTitle, Mode=OneWay}" Style="{StaticResource Body13StrongText}" />
              </StackPanel>
              <ItemsRepeater ItemsSource="{x:Bind ViewModel.ExportItems, Mode=OneWay}" Margin="18,0,0,0">
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Style="{StaticResource CaptionText}" LineHeight="19">
                      <Run Text="• " /><Run Text="{x:Bind}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
              <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                <Button x:Uid="Data_SaveFile" AutomationProperties.AutomationId="SaveExport" Style="{StaticResource PrimaryButton}" IsEnabled="False" ToolTipService.ToolTip="{x:Bind ViewModel.SaveDisabledReason, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.SaveDisabledReason, Mode=OneWay}" />
                <Button x:Uid="Data_ClosePreview" AutomationProperties.AutomationId="CloseExport" Style="{StaticResource SecondaryButton}" Command="{x:Bind ViewModel.CloseExportCommand, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SaveDisabledReason, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
              </controls:WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Replace from bundle -->
    <StackPanel>
      <TextBlock x:Uid="Data_ReplaceHeading" Style="{StaticResource Section16Text}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource HairlineRow}" Padding="0,10">
        <StackPanel Spacing="10">
          <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="6">
            <TextBlock x:Uid="Data_BundleLabel" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <ComboBox x:Uid="Data_BundleBox" AutomationProperties.AutomationId="ReplaceCandidate" Style="{StaticResource AppComboBox}" MinWidth="240" ItemsSource="{x:Bind ViewModel.ReplaceCandidates, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCandidate, Mode=TwoWay, Converter={StaticResource PassThrough}}" DisplayMemberPath="DisplayName" />
            <Button x:Uid="Data_Validate" AutomationProperties.AutomationId="ValidateReplace" Style="{StaticResource SecondaryButton}" MinWidth="100" controls:CapabilityGate.Key="PreviewReplaceImport" Command="{x:Bind ViewModel.ValidateReplaceCommand, Mode=OneWay}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceIdle), Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="6" MinWidth="100" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceValidating), Mode=OneWay}">
              <controls:BusyRing Size="12" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceValidating), Mode=OneWay}" VerticalAlignment="Center" />
              <TextBlock x:Uid="Data_Validating" Style="{StaticResource CaptionText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </controls:WrapPanel>
          <Border Style="{StaticResource CriticalAlert}" Padding="12,8" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceInvalid), Mode=OneWay}" AutomationProperties.AutomationId="ReplaceInvalid" controls:Motion.Entrance="True">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.ReplaceMessage, Mode=OneWay}" Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
              <Button Grid.Column="1" x:Uid="Data_ChooseAnother" Style="{StaticResource SmallSecondaryButton}" Command="{x:Bind ViewModel.ResetReplaceCommand, Mode=OneWay}" />
            </Grid>
          </Border>
          <Border BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceValid), Mode=OneWay}" AutomationProperties.AutomationId="ReplaceValid" controls:Motion.Entrance="True">
            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="6">
              <TextBlock Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" MaxWidth="460">
                <Run Text="✓ " Foreground="{ThemeResource OkBrush}" FontWeight="Bold" /><Run Text="{x:Bind ViewModel.ReplaceMessage, Mode=OneWay}" />
              </TextBlock>
              <Button x:Uid="Data_Replace" AutomationProperties.AutomationId="ConfirmReplace" Style="{StaticResource SmallDestructiveButton}" controls:CapabilityGate.Key="PreviewReplaceImport" Command="{x:Bind ViewModel.ConfirmReplaceCommand, Mode=OneWay}" />
              <Button x:Uid="Dialog_CancelButton" Style="{StaticResource SmallSecondaryButton}" MinHeight="26" Command="{x:Bind ViewModel.ResetReplaceCommand, Mode=OneWay}" />
            </controls:WrapPanel>
          </Border>
          <TextBlock x:Uid="Data_Replacing" Style="{StaticResource CaptionText}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceProcessing), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
          <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReplaceDone), Mode=OneWay}" AutomationProperties.AutomationId="ReplaceDone">
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center">
              <Run Text="✓ " Foreground="{ThemeResource OkBrush}" FontWeight="Bold" /><Run x:Uid="Data_ReplaceDoneRun" />
            </TextBlock>
            <Button x:Uid="Data_Done" Style="{StaticResource SmallLinkButton}" Command="{x:Bind ViewModel.ResetReplaceCommand, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Reset and delete -->
    <StackPanel>
      <TextBlock x:Uid="Data_ResetHeading" Style="{StaticResource Section16Text}" Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level2" />
      <Border Style="{StaticResource HairlineRow}" Padding="0,10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Data_ResetSettings" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Data_ResetSettingsHelp" Style="{StaticResource CaptionText}" LineHeight="17" />
          </StackPanel>
          <Button Grid.Column="1" x:Uid="Data_ResetSettingsButton" AutomationProperties.AutomationId="ResetSettings" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Command="{x:Bind ViewModel.ResetSettingsCommand, Mode=OneWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource HairlineRow}" Padding="0,10" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasAccounts), Mode=OneWay}">
        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
          <StackPanel MinWidth="220" MaxWidth="380">
            <TextBlock x:Uid="Data_DeleteAccount" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Data_DeleteAccountHelp" Style="{StaticResource CaptionText}" LineHeight="17" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Uid="Data_DeleteTarget" AutomationProperties.AutomationId="DeleteTarget" Style="{StaticResource AppComboBox}" MaxWidth="220" MinWidth="160" ItemsSource="{x:Bind ViewModel.DeleteTargets, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedDeleteTarget, Mode=TwoWay, Converter={StaticResource PassThrough}}" DisplayMemberPath="Label" />
            <Button x:Uid="Data_DeleteButton" AutomationProperties.AutomationId="DeleteAccountData" Style="{StaticResource DestructiveOutlineButton}" controls:CapabilityGate.Key="DeleteAccountData" Command="{x:Bind ViewModel.DeleteAccountDataCommand, Mode=OneWay}" />
          </StackPanel>
        </controls:WrapPanel>
      </Border>
      <Border Style="{StaticResource HairlineRow}" Padding="0,10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Uid="Data_EraseAll" Style="{StaticResource Body13Text}" />
            <TextBlock x:Uid="Data_EraseAllHelp" Style="{StaticResource CaptionText}" LineHeight="17" />
          </StackPanel>
          <Button Grid.Column="1" x:Uid="Data_EraseAllButton" AutomationProperties.AutomationId="FactoryReset" Style="{StaticResource DestructiveButton}" VerticalAlignment="Center" controls:CapabilityGate.Key="FactoryReset" Command="{x:Bind ViewModel.FactoryResetCommand, Mode=OneWay}" />
        </Grid>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
